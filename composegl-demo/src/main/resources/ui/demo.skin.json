    "table.row.selected": {
      "background": { "fill": "#604CC2FF" },
      "textColour": "#08131C",
      "hovered": { "background": { "fill": "#804CC2FF" } },
      "focused": { "background": { "fill": "#604CC2FF", "border": "#FFFFFF", "borderWidth": 2 } }
    },

    "table.cell": { "padding": [10, 5] },
    "table.empty": { "textColour": "#9AA4B2", "padding": 16 },

    // --- menus ---

    "menubar": { "background": { "fill": "#18FFFFFF", "border": "#30FFFFFF", "padding": [4, 2] } },

    "menubar.title": {
      "background": { "fill": "#00000000", "corner": 6, "padding": [10, 5] },
      "hovered": { "background": { "fill": "#284CC2FF", "corner": 6 } },
      "focused": { "background": { "fill": "#284CC2FF", "corner": 6, "border": "#FFFFFF", "borderWidth": 2 } },
