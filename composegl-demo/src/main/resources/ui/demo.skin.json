{
  // The example's own skin.
  //
  // Everything the example looks like is in this file: colours, corners, padding, which art each
  // panel is cut from and how far in its contents sit. Nothing in the example's Kotlin names a
  // colour. Save this file while the example is running and it changes on the next frame.

  "defaults": {
    "textColour": "#E6EAF2",
    "text": { "font": "body", "size": 16 }
  },

  "styles": {

    "screen": { "background": { "fill": "#0E1116" } },

    // --- art ---
    //
    // The two regions in ui.png, cut into nine here rather than in Kotlin. The padding is the
    // art's: change the picture, change the gap between the bevel and the text, and no layout
    // code moves.

    "panel": {
      "background": { "patch": "panel", "slice": 16, "padding": [20, 18] }
    },

    "heading": {
      "background": {
        "patch": "ribbon",
        "slice": [8, 10, 8, 10],
        "padding": [14, 5, 14, 6],
        // The hatch keeps its pitch across the ribbon instead of smearing into a grey wash.
        "edges": { "centreAcross": "tile" }
      },
      "text": { "size": 20 }
    },

    // The line between two sections of a panel. Faint, so it groups rather than fences.
    "divider": { "background": { "fill": "#40FFFFFF" } },

    // A panel with no art behind it, for the half of the screen that is drawn by the shader.
    "panel.flat": {
      "background": { "fill": "#F01B1F2A", "corner": 10, "border": "#40FFFFFF", "padding": 16 }
    },

    // --- text ---

    "label": {},
    "label.title": { "textColour": "#4CC2FF", "text": { "font": "display", "size": 34 } },
    "label.dim": { "textColour": "#9AA4B2", "text": { "size": 13 } },
    "label.body": { "textColour": "#9AA4B2" },

    // --- the things you press ---
    //
    // Four states in one style. A game writes the ones it cares about: anything left out falls
    // back to the style's own look, so a button with no "pressed" simply does not change when it
    // is pressed rather than disappearing.

    "button": {
      "background": { "fill": "#404CC2FF", "corner": 8, "border": "#4CC2FF", "padding": [16, 10] },
      "textColour": "#E6F4FF",
      "hovered": { "background": { "fill": "#804CC2FF", "corner": 8, "border": "#8ADBFF", "borderWidth": 2 } },
      "pressed": { "background": { "fill": "#FF4CC2FF", "corner": 8, "border": "#FFFFFF", "borderWidth": 2 }, "textColour": "#0B1119" },
      "focused": { "background": { "fill": "#404CC2FF", "corner": 8, "border": "#FFFFFF", "borderWidth": 2 } },
      "disabled": { "background": { "fill": "#141A22", "corner": 8, "border": "#2A3440" }, "textColour": "#5A6675" }
    },

    "button.listening": {
      "background": { "fill": "#40F0B429", "corner": 8, "border": "#F0B429", "borderWidth": 2, "padding": [16, 10] },
      "textColour": "#F0B429"
    },

    "button.quiet": {
      "background": { "fill": "#18FFFFFF", "corner": 8, "border": "#30FFFFFF", "padding": [16, 10] },
      "textColour": "#9AA4B2",
      "hovered": { "background": { "fill": "#284CC2FF", "corner": 8, "border": "#4CC2FF" } },
      "pressed": { "background": { "fill": "#484CC2FF", "corner": 8, "border": "#4CC2FF" } },
      "focused": { "background": { "fill": "#18FFFFFF", "corner": 8, "border": "#FFFFFF", "borderWidth": 2 } },
      "disabled": { "textColour": "#5A6675" }
    },

    // --- the chips under the briefing ---
    //
    // Four styles rather than one with a flag, because "chosen" is not a state the toolkit knows
    // about — a game invents its own names, and a name that falls back is free. Each is written
    // out whole: a style that exists is used as it is, and only a name nobody wrote falls back.

    // The two settings controls, in the example's own blue. The widgets are the toolkit's; which
    // blue, how round and how much padding are all here.

    "checkbox": {
      "background": { "fill": "#2000FFFF", "corner": 4, "border": "#4CC2FF", "padding": 3 },
      "hovered": { "background": { "fill": "#3000FFFF", "corner": 4, "border": "#8ADBFF", "borderWidth": 2 } },
      "focused": { "background": { "fill": "#2000FFFF", "corner": 4, "border": "#8ADBFF", "borderWidth": 2 } }
    },

    "checkbox.tick": { "background": { "fill": "#4CC2FF", "corner": 2 } },

    "toggle": {
      "background": { "fill": "#2000FFFF", "corner": 11, "border": "#4CC2FF", "padding": 3 },
      "hovered": { "background": { "fill": "#3000FFFF", "corner": 11, "border": "#8ADBFF", "borderWidth": 2 } },
      "focused": { "background": { "fill": "#2000FFFF", "corner": 11, "border": "#8ADBFF", "borderWidth": 2 } }
    },

    "toggle.on": {
      "background": { "fill": "#604CC2FF", "corner": 11, "border": "#8ADBFF", "padding": 3 },
      "hovered": { "background": { "fill": "#804CC2FF", "corner": 11, "border": "#8ADBFF", "borderWidth": 2 } },
      "focused": { "background": { "fill": "#604CC2FF", "corner": 11, "border": "#FFFFFF", "borderWidth": 2 } }
    },

    "toggle.knob": { "background": { "fill": "#E8F4FF", "corner": 8 } },

    "slider.track": { "background": { "fill": "#40000000", "corner": 3 } },
    "slider.fill": { "background": { "fill": "#4CC2FF", "corner": 3 } },

    "slider.knob": {
      "background": { "fill": "#E8F4FF", "corner": 8, "border": "#4CC2FF" },
      "hovered": { "background": { "fill": "#FFFFFF", "corner": 8, "border": "#8ADBFF", "borderWidth": 2 } },
      "focused": { "background": { "fill": "#FFFFFF", "corner": 8, "border": "#8ADBFF", "borderWidth": 2 } }
    },

    "stepper": {
      "background": { "fill": "#2000FFFF", "corner": 6, "border": "#304CC2FF", "padding": [2, 4] },
      "hovered": { "background": { "fill": "#3000FFFF", "corner": 6, "border": "#4CC2FF" } },
      "focused": { "background": { "fill": "#2000FFFF", "corner": 6, "border": "#8ADBFF", "borderWidth": 2 } }
    },

    "stepper.arrow": {
      "textColour": "#4CC2FF",
      "padding": [10, 2],
      "hovered": { "textColour": "#8ADBFF" },
      "pressed": { "textColour": "#FFFFFF", "contentOffset": [0, 1] },
      "disabled": { "textColour": "#304CC2FF" }
    },

    "stepper.value": { "textColour": "#E8F4FF", "padding": [8, 2] },

    // --- typing ---
    //
    // The caret and the highlight are their own styles because a game restyles them separately:
    // a light interface wants a dark caret, and a selection has to stay readable under the text.

    "field": {
      "background": { "fill": "#600E1116", "corner": 6, "border": "#304CC2FF", "padding": [10, 7] },
      "hovered": { "background": { "fill": "#600E1116", "corner": 6, "border": "#604CC2FF" } },
      "focused": { "background": { "fill": "#600E1116", "corner": 6, "border": "#8ADBFF", "borderWidth": 2 } },
      "disabled": { "textColour": "#5A6675" }
    },

    "field.placeholder": { "textColour": "#5A6675" },
    "field.caret": { "background": { "fill": "#E6F0FF" } },
    "field.selection": { "background": { "fill": "#504CC2FF" } },
    // The underline under text an input method has not committed yet.
    "field.composition": { "background": { "fill": "#8ADBFF" } },

    // --- the tabs and the dialogue ---

    "tab": {
      "background": { "fill": "#18FFFFFF", "corner": 6, "border": "#30FFFFFF", "padding": [14, 6] },
      "textColour": "#9AA4B2",
      "text": { "size": 13 },
      "hovered": { "background": { "fill": "#284CC2FF", "corner": 6, "border": "#4CC2FF" } },
      "focused": { "background": { "fill": "#18FFFFFF", "corner": 6, "border": "#8ADBFF", "borderWidth": 2 } }
    },

    "tab.selected": {
      "background": { "fill": "#404CC2FF", "corner": 6, "border": "#4CC2FF", "borderWidth": 2, "padding": [14, 6] },
      "textColour": "#4CC2FF",
      "text": { "size": 13 },
      "hovered": { "background": { "fill": "#504CC2FF", "corner": 6, "border": "#4CC2FF", "borderWidth": 2 } }
    },

    // A dim over the whole screen, so what is behind the question reads as out of reach.
    "scrim": { "background": { "fill": "#B00E1116" } },

    "dialog": {
      "background": { "fill": "#F21B1F2A", "corner": 12, "border": "#4CC2FF", "padding": 20 }
    },

    "scrollbar.track": { "background": { "fill": "#30000000", "corner": 4 } },

    "scrollbar.thumb": {
      "background": { "fill": "#604CC2FF", "corner": 4 },
      "hovered": { "background": { "fill": "#4CC2FF", "corner": 4 } }
    },

    "chip": {
      "background": { "fill": "#20FFFFFF", "corner": 6, "border": "#4CC2FF", "padding": [14, 8] },
      "textColour": "#4CC2FF",
      "text": { "size": 13 },
      "hovered": { "background": { "fill": "#284CC2FF", "corner": 6, "border": "#4CC2FF", "borderWidth": 2 } },
      "pressed": { "background": { "fill": "#604CC2FF", "corner": 6, "border": "#4CC2FF", "borderWidth": 2 } }
    },

    "chip.chosen": {
      "background": { "fill": "#504CC2FF", "corner": 6, "border": "#4CC2FF", "borderWidth": 2, "padding": [14, 8] },
      "textColour": "#4CC2FF",
      "text": { "size": 13 },
      "hovered": { "background": { "fill": "#604CC2FF", "corner": 6, "border": "#4CC2FF", "borderWidth": 2 } }
    },

    "chip.danger": {
      "background": { "fill": "#20FFFFFF", "corner": 6, "border": "#FF5C5C", "padding": [14, 8] },
      "textColour": "#FF5C5C",
      "text": { "size": 13 },
      "hovered": { "background": { "fill": "#28FF5C5C", "corner": 6, "border": "#FF5C5C", "borderWidth": 2 } },
      "pressed": { "background": { "fill": "#60FF5C5C", "corner": 6, "border": "#FF5C5C", "borderWidth": 2 } }
    },

    "chip.danger.chosen": {
      "background": { "fill": "#50FF5C5C", "corner": 6, "border": "#FF5C5C", "borderWidth": 2, "padding": [14, 8] },
      "textColour": "#FF5C5C",
      "text": { "size": 13 },
      "hovered": { "background": { "fill": "#60FF5C5C", "corner": 6, "border": "#FF5C5C", "borderWidth": 2 } }
    },

    // --- the hotbar ---

    "slot": {
      "background": { "fill": "#30000000", "corner": 8, "border": "#30FFFFFF" },
      "textColour": "#9AA4B2",
      "hovered": { "background": { "fill": "#18FFFFFF", "corner": 8, "border": "#80FFFFFF" } },
      "pressed": { "background": { "fill": "#604CC2FF", "corner": 8, "border": "#4CC2FF" } }
    },

    "slot.lit": {
      "background": { "fill": "#304CC2FF", "corner": 8, "border": "#4CC2FF", "borderWidth": 2 },
      "textColour": "#4CC2FF",
      "hovered": { "background": { "fill": "#404CC2FF", "corner": 8, "border": "#4CC2FF", "borderWidth": 2 } }
    },

    // --- bars ---

    "bar.track": { "background": { "fill": "#40000000", "corner": 5 } },
    "bar.fill": { "background": { "fill": "#FF5C5C", "corner": 5 } },
    "bar.fill.low": { "background": { "fill": "#FFB454", "corner": 5 } },
    "bar.fill.critical": { "background": { "fill": "#FF2B2B", "corner": 5 } },
    // The ghost of what was just lost: the fill's colour, dimmed, so the eye reads one bar.
    "bar.trail": { "background": { "fill": "#70FF5C5C", "corner": 5 } },
    "bar.segment": { "background": { "fill": "#0A1018" } },

    // A bar with its own colours is a whole set of styles, not a fill: track, trail and notch all
    // belong to it. This is what a game writes when it wants a second bar that is not the first.

    "bar.shield.track": { "background": { "fill": "#40000000", "corner": 5 } },
    "bar.shield.fill": { "background": { "fill": "#4CC2FF", "corner": 5 } },
    "bar.shield.trail": { "background": { "fill": "#704CC2FF", "corner": 5 } },
    "bar.shield.segment": { "background": { "fill": "#0A1018" } },

    "bar.stamina.track": { "background": { "fill": "#40000000", "corner": 5 } },
    "bar.stamina.fill": { "background": { "fill": "#7BE08A", "corner": 5 } },
    "bar.stamina.trail": { "background": { "fill": "#707BE08A", "corner": 5 } },
    "bar.stamina.segment": { "background": { "fill": "#0A1018" } },

    // --- the hotbar ---
    //
    // The slot styles the toolkit's Hotbar asks for, in this skin's own colours. An empty slot is
    // a hole with nothing in it; a slot holding something unusable is a full slot, dimmed.

    "hotbar.slot": {
      "background": { "fill": "#141B24", "corner": 8, "border": "#243140" },
      "hovered": { "background": { "fill": "#1C2632", "corner": 8, "border": "#4CC2FF" } },
      "focused": { "background": { "fill": "#1C2632", "corner": 8, "border": "#4CC2FF", "borderWidth": 2 } },
      "disabled": { "textColour": "#4A5A6A", "tint": "#80FFFFFF" }
    },

    "hotbar.slot.selected": {
      "background": { "fill": "#304CC2FF", "corner": 8, "border": "#4CC2FF", "borderWidth": 2 },
      "textColour": "#4CC2FF",
      "hovered": { "background": { "fill": "#404CC2FF", "corner": 8, "border": "#4CC2FF", "borderWidth": 2 } }
    },

    "hotbar.slot.empty": {
      "background": { "fill": "#0B1119", "corner": 8, "border": "#18212B" }
    },

    "hotbar.prompt": { "textColour": "#6E8093", "text": { "size": 13 } },
    "hotbar.charges": { "textColour": "#FFFFFF", "text": { "size": 13 } },

    // --- the inventory grid ---
    //
    // An empty square is a hole to put something in and a square with something in it is a tile
    // over that hole. The two footprints are the answer to "will it go here?", given while the
    // thing is still in the air, so both are see-through: the squares underneath still read.

    "inventory.cell": {
      "background": { "fill": "#0B1119", "corner": 6, "border": "#18212B" },
      "hovered": { "background": { "fill": "#141B24", "corner": 6, "border": "#4CC2FF" } },
      "focused": { "background": { "fill": "#141B24", "corner": 6, "border": "#4CC2FF", "borderWidth": 2 } }
    },

    "inventory.item": {
      "background": { "fill": "#141B24", "corner": 6, "border": "#243140" },
      "hovered": { "background": { "fill": "#1C2632", "corner": 6, "border": "#4CC2FF" } },
      "focused": { "background": { "fill": "#1C2632", "corner": 6, "border": "#4CC2FF", "borderWidth": 2 } },
      "disabled": { "textColour": "#4A5A6A", "tint": "#80FFFFFF" }
    },

    "inventory.count": { "textColour": "#FFFFFF", "text": { "size": 13 } },
    "inventory.footprint": { "background": { "fill": "#6046A758", "corner": 6, "border": "#46A758" } },
    "inventory.footprint.invalid": { "background": { "fill": "#80E5484D", "corner": 6, "border": "#E5484D" } },
    "inventory.split": { "background": { "fill": "#F0141B24", "corner": 8, "border": "#4CC2FF" } },

    // --- the item card ---
    //
    // Darker than a panel, because it is drawn over the bag it came out of and has to read against
    // it. The edge written here is only the fallback: the widget re-edges the card in the item's
    // own tier colour, and "itemtip.rarity" is the tier colour for a game that names none.
    //
    // The card beside it — what is equipped now — is sunk rather than raised, so the eye lands on
    // the new thing first. Better and worse are a colour *and* a mark, and the mark is what a
    // player who cannot tell those two colours apart reads.

    "itemtip": {
      "background": { "fill": "#F00B1119", "corner": 6, "border": "#2A3440", "borderWidth": 2, "padding": [10, 8] },
      "textColour": "#C9D3E0",
      "text": { "size": 13 }
    },
    "itemtip.compare": {
      "background": { "fill": "#F0070A0F", "corner": 6, "border": "#1C242E", "borderWidth": 2, "padding": [10, 8] }
    },
    "itemtip.rarity": { "background": { "fill": "#4CC2FF" } },
    "itemtip.title": { "textColour": "#E6EAF2", "text": { "size": 16 } },
    "itemtip.subtitle": { "textColour": "#9AA4B2", "text": { "size": 12 } },
    "itemtip.label": { "textColour": "#9AA4B2", "text": { "size": 13 } },
    "itemtip.value": { "textColour": "#E6EAF2", "text": { "size": 13 } },
    "itemtip.better": { "textColour": "#7BE08A", "text": { "size": 13 } },
    "itemtip.worse": { "textColour": "#FF8080", "text": { "size": 13 } },
    "itemtip.same": { "textColour": "#8E9AAB", "text": { "size": 13 } },
    "itemtip.flavour": { "textColour": "#8E9AAB", "text": { "size": 12 } },
    "itemtip.hint": { "textColour": "#7C8798", "text": { "size": 12 } },

    // --- the skill tree ---
    //
    // Four states a node can be in, and each one is a different edge as well as a different fill:
    // locked is grey and sunk, available is lit in the accent, owned is green, maxed is gold. The
    // lines between them say the same thing again, so the shape of what is unlocked reads from
    // across the room without any node being clicked on.

    "skilltree.plane": {
      "background": { "fill": "#080B10" },
      "focused": { "background": { "fill": "#080B10", "border": "#4CC2FF", "borderWidth": 2 } }
    },
    "skilltree.node.locked": {
      "background": { "fill": "#0B1119", "corner": 8, "border": "#243140" },
      "textColour": "#6E8093",
      "hovered": { "background": { "fill": "#141B24", "corner": 8, "border": "#2A3440" } },
      "focused": { "background": { "fill": "#141B24", "corner": 8, "border": "#4CC2FF", "borderWidth": 2 } },
      "disabled": { "textColour": "#4A5A6A", "tint": "#90FFFFFF" }
    },
    "skilltree.node.available": {
      "background": { "fill": "#14283A", "corner": 8, "border": "#4CC2FF", "borderWidth": 2 },
      "textColour": "#E6EAF2",
      "hovered": { "background": { "fill": "#1B3550", "corner": 8, "border": "#8ADBFF", "borderWidth": 2 } },
      "pressed": { "background": { "fill": "#21405F", "corner": 8, "border": "#8ADBFF", "borderWidth": 2 } },
      "focused": { "background": { "fill": "#1B3550", "corner": 8, "border": "#8ADBFF", "borderWidth": 2 } },
      "disabled": { "textColour": "#4A5A6A", "tint": "#90FFFFFF" }
    },
    "skilltree.node.owned": {
      "background": { "fill": "#123324", "corner": 8, "border": "#46A758", "borderWidth": 2 },
      "textColour": "#E6EAF2",
      "hovered": { "background": { "fill": "#18452F", "corner": 8, "border": "#7BE08A", "borderWidth": 2 } },
      "pressed": { "background": { "fill": "#1D5238", "corner": 8, "border": "#7BE08A", "borderWidth": 2 } },
      "focused": { "background": { "fill": "#18452F", "corner": 8, "border": "#4CC2FF", "borderWidth": 2 } },
      "disabled": { "textColour": "#4A5A6A", "tint": "#90FFFFFF" }
    },
    "skilltree.node.maxed": {
      "background": { "fill": "#40340F", "corner": 8, "border": "#F2C94C", "borderWidth": 2 },
      "textColour": "#FFF2D6",
      "hovered": { "background": { "fill": "#524218", "corner": 8, "border": "#FFE9A8", "borderWidth": 2 } },
      "focused": { "background": { "fill": "#524218", "corner": 8, "border": "#4CC2FF", "borderWidth": 2 } },
      "disabled": { "textColour": "#9A8560", "tint": "#90FFFFFF" }
    },
    "skilltree.hold": { "background": { "fill": "#804CC2FF" } },
    "skilltree.rank": { "textColour": "#9AA4B2", "text": { "size": 12 } },
    "skilltree.edge.locked": { "background": { "fill": "#66243140" } },
    "skilltree.edge.available": { "background": { "fill": "#CC4CC2FF" } },
    "skilltree.edge.owned": { "background": { "fill": "#CC46A758" } },
    "skilltree.edge.fill": { "background": { "fill": "#FFB9F5CE" } },

    // --- abilities ---

    "cooldown.sweep": { "background": { "fill": "#B0060A12" } },
    "cooldown.flash": { "background": { "fill": "#804CC2FF" } },
    "cooldown.seconds": { "textColour": "#FFFFFF", "text": { "size": 16 } },

    // --- what a hit is worth ---
    //
    // A critical is a different colour and a size up, so it is read as "that was a big one"
    // without anybody reading the number.
    "damage": { "textColour": "#FFE9A8", "text": { "size": 16 } },
    "damage.critical": { "textColour": "#FF7A45", "text": { "size": 20 } },

    // --- a marker held at the edge of the screen ---
    //
    // What is inside a world marker is the game's own interface, so the only thing the layer draws
    // itself is the little triangle beside a marker it is holding at the edge, turned to point at
    // where the thing really is. Pale, because it is read against whatever the game draws behind it.
    "marker.arrow": { "background": { "fill": "#E8ECF2" } },

    // --- where the player is ---
    //
    // A ring outside the thing it marks, with its padding there whether the ring is drawn or not,
    // so gaining focus never shifts the layout.

    "focusRing": {
      "background": { "fill": "#00000000", "corner": 9, "border": "#FFFFFF", "padding": 3 }
    },

    "focusRing.hidden": { "background": "none", "padding": 3 },

    // The pointer cross uses the text colour; the crosshair on the range uses the fill.
    "reticle": { "textColour": "#4CC2FF", "background": { "fill": "#E8ECF2" } },
    "reticle.hostile": { "background": { "fill": "#FF5A4F" } },
    "reticle.hit": { "background": { "fill": "#FFFFFF" } },
    "reticle.kill": { "background": { "fill": "#FF5A4F" } },

    // A tooltip, which is drawn over everything else on the screen.
    "tooltip": {
      "background": { "fill": "#F0151B26", "corner": 4, "border": "#4CC2FF", "padding": [8, 5] },
      "textColour": "#E8ECF2",
      "text": { "size": 13 }
    },

    // What is being shot at on the range.
    "target": { "background": { "fill": "#2A3446", "corner": 6, "border": "#5A6B86", "borderWidth": 2 } },

    // What the game is telling the player, in the corner. The card, its second line, and the
    // count of the ones still waiting behind it.
    "notification": {
      "background": { "fill": "#E61B2230", "corner": 5, "border": "#5A6B86", "padding": [12, 9] },
      "textColour": "#E8ECF2",
      "text": { "size": 13 }
    },
    "notification.detail": { "textColour": "#9AA4B2", "text": { "size": 13 } },
    "notification.more": { "textColour": "#7C8798", "text": { "size": 13 } },

    // --- the objective list ---
    //
    // See-through, because the corner it sits in is still somewhere the game is happening. The
    // quest's name is the accent, a step is ordinary text, and a finished step is dimmed — the
    // line struck through it is drawn in whatever colour the step itself is, so it dims with it.
    // The little box beside each step is the hole the tick is drawn into.

    "objective": {
      "background": { "fill": "#B30B1119", "corner": 5, "border": "#2A3440", "padding": [12, 10] }
    },
    "objective.title": { "textColour": "#4CC2FF", "text": { "size": 15 } },
    "objective.step": { "textColour": "#E6EAF2", "text": { "size": 14 } },
    "objective.step.done": { "textColour": "#8E9AAB", "text": { "size": 14 } },
    "objective.bullet": { "background": { "fill": "#080B10", "corner": 3, "border": "#4A5568" } },
    "objective.tick": { "background": { "fill": "#46A758" } },
    "objective.count": { "textColour": "#9AA4B2", "text": { "size": 13 } },
    "objective.more": {
      "background": { "fill": "#00000000", "corner": 4, "padding": [4, 2] },
      "textColour": "#7C8798",
      "text": { "size": 13 },
      "hovered": { "background": { "fill": "#1B2230", "corner": 4 }, "textColour": "#C9D3E0" },
      "focused": { "background": { "fill": "#24303F", "corner": 4, "border": "#4CC2FF" } },
      "pressed": { "background": { "fill": "#080B10", "corner": 4 }, "contentOffset": [0, 1] }
    },

    // In-game chat: the panel it scrolls in when it is open, a line, a line nobody said, the name
    // in front of one, the channel it came in on, the tabs, and the box the player types in. See-
    // through like the objective list, because chat sits over a game that is still being played.
    // A game's own channels can name a style of their own — "chat.team" — which is where a
    // channel's colour comes from, and is the game's to invent rather than the toolkit's.

    "chat": {
      "background": { "fill": "#CC0B1119", "corner": 6, "border": "#2A3440", "padding": [10, 8] },
      "textColour": "#C9D3E0"
    },
    "chat.message": { "textColour": "#E6EAF2", "text": { "size": 14 } },
    "chat.system": { "textColour": "#F2C94C", "text": { "size": 14 } },
    "chat.name": { "textColour": "#4CC2FF", "text": { "size": 14 } },
    "chat.channel": { "textColour": "#9AA4B2", "text": { "size": 14 } },

    "chat.tab": {
      "background": { "fill": "#18FFFFFF", "corner": 4, "border": "#30FFFFFF", "padding": [10, 4] },
      "textColour": "#9AA4B2",
      "text": { "size": 13 },
      "hovered": { "background": { "fill": "#284CC2FF", "corner": 4, "border": "#4CC2FF" } },
      "focused": { "background": { "fill": "#18FFFFFF", "corner": 4, "border": "#8ADBFF", "borderWidth": 2 } },
      "pressed": {
        "background": { "fill": "#080B10", "corner": 4, "border": "#30FFFFFF" },
        "contentOffset": [0, 1]
      }
    },
    "chat.tab.selected": {
      "background": { "fill": "#404CC2FF", "corner": 4, "border": "#4CC2FF", "borderWidth": 2, "padding": [10, 4] },
      "textColour": "#E6EAF2",
      "text": { "size": 13 },
      "hovered": { "background": { "fill": "#504CC2FF", "corner": 4, "border": "#8ADBFF", "borderWidth": 2 } },
      "pressed": {
        "background": { "fill": "#284CC2FF", "corner": 4, "border": "#4CC2FF", "borderWidth": 2 },
        "contentOffset": [0, 1]
      }
    },

    // No box of its own round the input: the panel is the box, and a second border inside it is
    // one line of chrome too many on a HUD.
    "chat.field": {
      "background": { "fill": "#00000000", "padding": [2, 3] },
      "textColour": "#E6EAF2"
    },
    "chat.field.placeholder": { "textColour": "#5A6675" },
    "chat.field.caret": { "background": { "fill": "#E6F0FF" } },
    "chat.field.selection": { "background": { "fill": "#504CC2FF" } },
    "chat.field.composition": { "background": { "fill": "#8ADBFF" } },

    // The chrome round the minimap. The padding is the hole the game draws its own map into.
    "minimap": {
      "background": { "fill": "#151B26", "corner": 6, "border": "#5A6B86", "padding": [7, 7] }
    },
    "minimap.marker": { "background": { "fill": "#4CC2FF" } },
    "minimap.objective": { "background": { "fill": "#F2C94C" } },
    "minimap.compass": { "textColour": "#9AA4B2", "text": { "size": 13 } },

    // The button a player is being asked to press. One style does every device: what changes is
    // the letter in the box, and a skin with real pad art names "prompt.pad.south" and so on.
    "prompt": {
      "background": { "fill": "#39445A", "corner": 4, "border": "#8994A8", "padding": [6, 0] },
      "textColour": "#E8ECF2",
      "text": { "size": 13 }
    },

    // --- the rest of the toolkit ---
    //
    // A skin does not have to answer every name: a widget whose style nobody wrote still draws,
    // because a missing style falls back to a plainer one and then to nothing at all. The catch is
    // what "nothing at all" looks like — no fill, no edge, no highlight — so a tree row that is
    // chosen looks exactly like one that is not, and the pad's cursor disappears. That is invisible
    // until somebody uses the widget, which is why the rest of the toolkit's names are written out
    // here in this example's own blue rather than left to fall back.

    "panel.raised": {
      "background": { "fill": "#F0232B38", "corner": 10, "border": "#40FFFFFF", "padding": 16 }
    },

    "separator": { "background": { "fill": "#40FFFFFF" } },

    "label.heading": { "textColour": "#E6EAF2", "text": { "size": 18 } },
    "label.danger": { "textColour": "#FF5C5C" },
    "label.good": { "textColour": "#7BE08A" },

    // --- more buttons ---

    "button.primary": {
      "background": { "fill": "#804CC2FF", "corner": 8, "border": "#8ADBFF", "borderWidth": 2, "padding": [16, 10] },
      "textColour": "#08131C",
      "hovered": { "background": { "fill": "#B04CC2FF", "corner": 8, "border": "#FFFFFF", "borderWidth": 2 } },
      "pressed": { "background": { "fill": "#FF4CC2FF", "corner": 8, "border": "#FFFFFF", "borderWidth": 2 } }
    },

    "button.danger": {
      "background": { "fill": "#40FF5C5C", "corner": 8, "border": "#FF5C5C", "padding": [16, 10] },
      "textColour": "#FFD5D5",
      "hovered": { "background": { "fill": "#70FF5C5C", "corner": 8, "border": "#FF8F8F", "borderWidth": 2 } },
      "pressed": { "background": { "fill": "#A0FF5C5C", "corner": 8, "border": "#FFFFFF", "borderWidth": 2 } }
    },

    "button.icon": {
      "background": { "fill": "#18FFFFFF", "corner": 8, "border": "#30FFFFFF", "padding": 6 },
      "hovered": { "background": { "fill": "#284CC2FF", "corner": 8, "border": "#4CC2FF" } },
      "focused": { "background": { "fill": "#18FFFFFF", "corner": 8, "border": "#FFFFFF", "borderWidth": 2 } },
      "pressed": { "contentOffset": [0, 1] }
    },

    // The keyboard a pad player types with: a panel of small keys, with Shift lit while the next
    // letter is a capital.

    "panel.keyboard": {
      "background": { "fill": "#F01B1F2A", "corner": 12, "border": "#304CC2FF", "padding": 12 }
    },

    "button.key": {
      "background": { "fill": "#18FFFFFF", "corner": 6, "border": "#30FFFFFF", "padding": [4, 7] },
      "textColour": "#E6EAF2",
      "hovered": { "background": { "fill": "#284CC2FF", "corner": 6, "border": "#4CC2FF" } },
      "focused": { "background": { "fill": "#404CC2FF", "corner": 6, "border": "#FFFFFF", "borderWidth": 2 } },
      "pressed": { "background": { "fill": "#604CC2FF", "corner": 6, "border": "#4CC2FF" }, "contentOffset": [0, 1] },
      "disabled": { "textColour": "#5A6675" }
    },

    "button.key.on": {
      "background": { "fill": "#804CC2FF", "corner": 6, "border": "#8ADBFF", "borderWidth": 2, "padding": [4, 7] },
      "textColour": "#08131C",
      "focused": { "background": { "fill": "#804CC2FF", "corner": 6, "border": "#FFFFFF", "borderWidth": 2 } }
    },

    // --- more things that take a value ---

    "radio": {
      "background": { "fill": "#2000FFFF", "corner": 8, "border": "#4CC2FF", "padding": 3 },
      "hovered": { "background": { "fill": "#3000FFFF", "corner": 8, "border": "#8ADBFF", "borderWidth": 2 } },
      "focused": { "background": { "fill": "#2000FFFF", "corner": 8, "border": "#8ADBFF", "borderWidth": 2 } }
    },

    "radio.dot": { "background": { "fill": "#4CC2FF", "corner": 5 } },

    // A pan-and-zoom canvas is a window onto a world, so all it looks like is the dark behind that
    // world and a ring when the pad has focus on the canvas itself.
    "panzoom": {
      "background": { "fill": "#080B10", "corner": 6 },
      "focused": { "background": { "fill": "#080B10", "corner": 6, "border": "#8ADBFF", "borderWidth": 2 } }
    },

    // The bar between two panes. Quiet until the pointer finds it, so there is something to grab
    // before the cursor says so.
    "splitter": {
      "background": { "fill": "#30FFFFFF", "corner": 2 },
      "hovered": { "background": { "fill": "#804CC2FF", "corner": 2 } },
      "pressed": { "background": { "fill": "#4CC2FF", "corner": 2 } },
      "focused": { "background": { "fill": "#804CC2FF", "corner": 2, "border": "#FFFFFF", "borderWidth": 2 } }
    },

    // Working, for an unknown length of time.
    "spinner": { "textColour": "#4CC2FF" },
    "spinner.track": { "textColour": "#28FFFFFF" },
    // The padding is the room the track's own edge needs: the block is drawn inside it, so a track
    // with an outline and no padding is a track whose outline the block paints over.
    "indeterminatebar.track": {
      "background": { "fill": "#40000000", "corner": 4, "border": "#304CC2FF", "padding": 2 }
    },
    "indeterminatebar.fill": { "background": { "fill": "#4CC2FF", "corner": 3 } },

    // A colour picker: the panel, the frame round its square and strips, the ring that marks the
    // colour, and the checkerboard behind a see-through one.
    "colourpicker": {
      "background": { "fill": "#F01B1F2A", "corner": 10, "border": "#304CC2FF", "padding": 12 }
    },
    "colourpicker.area": {
      "background": { "fill": "#0B1119", "corner": 4, "border": "#304CC2FF" },
      "hovered": { "background": { "fill": "#0B1119", "corner": 4, "border": "#4CC2FF" } },
      "focused": { "background": { "fill": "#0B1119", "corner": 4, "border": "#8ADBFF", "borderWidth": 2 } }
    },
    "colourpicker.marker": { "background": { "fill": "#0B1119" }, "textColour": "#FFFFFF" },
    "colourpicker.checker": { "background": { "fill": "#C8CCD2" }, "textColour": "#8A9099" },
    "colourswatch": {
      "background": { "fill": "#0B1119", "corner": 4, "border": "#304CC2FF", "padding": 2 },
      "hovered": { "background": { "fill": "#0B1119", "corner": 4, "border": "#4CC2FF", "padding": 2 } },
      "focused": { "background": { "fill": "#0B1119", "corner": 4, "border": "#FFFFFF", "borderWidth": 2, "padding": 2 } },
      "pressed": { "background": { "fill": "#0B1119", "corner": 4, "border": "#8ADBFF", "padding": 2 } }
    },

    // --- lists, dropdowns and folding sections ---
    //
    // A row of a list is flat until something happens to it. The three things that can happen —
    // the pointer is over it, the pad is on it, it is the chosen one — have to look different from
    // each other and from nothing at all, or a player cannot tell where they are.

    "item": {
      "background": "none",
      "padding": [10, 6],
      "hovered": { "background": { "fill": "#18FFFFFF", "corner": 6 } },
      "focused": { "background": { "fill": "#18FFFFFF", "corner": 6, "border": "#FFFFFF", "borderWidth": 2 } },
      "pressed": { "background": { "fill": "#284CC2FF", "corner": 6 } },
      "disabled": { "textColour": "#5A6675" }
