    "subtitle": {
      "background": { "fill": "#0A0E14", "corner": 6, "padding": [16, 10] },
      "textColour": "#F2F5FA",
      "text": { "size": 16 }
    },
    "subtitle.speaker": { "textColour": "#4CC2FF", "text": { "size": 16 } },
    "subtitle.caption": { "textColour": "#C7D0DC", "text": { "size": 16 } },

    // --- somebody talking to you ---
    //
    // The box is the only thing on screen while it is up, so it is nearly opaque and the answers
