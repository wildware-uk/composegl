    "item.selected": {
      "background": { "fill": "#604CC2FF", "corner": 6, "padding": [10, 6] },
      "textColour": "#08131C",
      "hovered": { "background": { "fill": "#804CC2FF", "corner": 6 } },
      "focused": { "background": { "fill": "#604CC2FF", "corner": 6, "border": "#FFFFFF", "borderWidth": 2 } }
    },

    "dropdown": {
      "background": { "fill": "#600E1116", "corner": 6, "border": "#304CC2FF", "padding": [10, 7] },
      "hovered": { "background": { "fill": "#600E1116", "corner": 6, "border": "#604CC2FF" } },
      "focused": { "background": { "fill": "#600E1116", "corner": 6, "border": "#8ADBFF", "borderWidth": 2 } },
      "pressed": { "background": { "fill": "#284CC2FF", "corner": 6, "border": "#4CC2FF" } },
      "disabled": { "textColour": "#5A6675" }
    },

    "dropdown.list": {
      "background": { "fill": "#F21B1F2A", "corner": 8, "border": "#4CC2FF", "padding": 4 }
    },

    "collapsingheader": {
      "background": { "fill": "#18FFFFFF", "corner": 6, "padding": [10, 7] },
      "hovered": { "background": { "fill": "#284CC2FF", "corner": 6 } },
      "focused": { "background": { "fill": "#18FFFFFF", "corner": 6, "border": "#FFFFFF", "borderWidth": 2 } },
      "pressed": { "background": { "fill": "#404CC2FF", "corner": 6 } }
    },

    "collapsingheader.open": {
      "background": { "fill": "#404CC2FF", "corner": 6, "padding": [10, 7] },
      "textColour": "#E6F4FF",
      "hovered": { "background": { "fill": "#604CC2FF", "corner": 6 } },
      "focused": { "background": { "fill": "#404CC2FF", "corner": 6, "border": "#FFFFFF", "borderWidth": 2 } },
      "pressed": { "background": { "fill": "#804CC2FF", "corner": 6 } }
    },

    "collapsingheader.glyph": {
      "textColour": "#4CC2FF",
      "hovered": { "textColour": "#8ADBFF" },
      "focused": { "textColour": "#FFFFFF" },
      "disabled": { "textColour": "#5A6675" }
    },

    "collapsingheader.body": { "padding": [14, 8] },

    // --- trees ---

    "tree.row": {
      "background": "none",
      "padding": [8, 4],
      "hovered": { "background": { "fill": "#18FFFFFF", "corner": 5 } },
      "focused": { "background": { "fill": "#18FFFFFF", "corner": 5, "border": "#FFFFFF", "borderWidth": 2 } },
      "pressed": { "background": { "fill": "#284CC2FF", "corner": 5 } },
      "disabled": { "textColour": "#5A6675" }
    },

    "tree.row.selected": {
      "background": { "fill": "#604CC2FF", "corner": 5, "padding": [8, 4] },
      "textColour": "#08131C",
      "hovered": { "background": { "fill": "#804CC2FF", "corner": 5 } },
      "focused": { "background": { "fill": "#604CC2FF", "corner": 5, "border": "#FFFFFF", "borderWidth": 2 } }
    },

    "tree.toggle": { "textColour": "#9AA4B2", "hovered": { "textColour": "#4CC2FF" } },
    "tree.toggle.open": { "textColour": "#4CC2FF", "hovered": { "textColour": "#8ADBFF" } },
    "tree.guide": { "background": { "fill": "#28FFFFFF" } },

    // --- tables ---
    //
    // Rows and the header carry no padding of their own: the cells carry it, so the titles line up
    // over the values.

    "table": { "background": { "fill": "#600E1116", "corner": 8, "border": "#304CC2FF", "padding": 2 } },
    "table.header": { "background": { "fill": "#18FFFFFF" } },

    "table.header.cell": {
      "background": "none",
      "textColour": "#9AA4B2",
      "padding": [10, 6],
      "text": { "size": 13 },
      "hovered": { "background": { "fill": "#284CC2FF" }, "textColour": "#E6EAF2" },
      "focused": { "background": { "fill": "#284CC2FF", "border": "#FFFFFF", "borderWidth": 2 }, "textColour": "#E6EAF2" },
      "pressed": { "background": { "fill": "#404CC2FF" } }
    },

    "table.header.cell.sorted": {
      "background": "none",
      "textColour": "#4CC2FF",
      "padding": [10, 6],
      "text": { "size": 13 },
      "hovered": { "background": { "fill": "#284CC2FF" } },
      "focused": { "background": { "fill": "#284CC2FF", "border": "#FFFFFF", "borderWidth": 2 } },
      "pressed": { "background": { "fill": "#404CC2FF" } }
    },

    // The grab area is nine wide; the padding is what is left either side of the line drawn in it.
    "table.divider": {
      "background": { "fill": "#30FFFFFF" },
      "padding": [4, 6],
      "hovered": { "background": { "fill": "#4CC2FF" } },
      "pressed": { "background": { "fill": "#8ADBFF" } }
    },

    "table.row": {
      "background": "none",
      "hovered": { "background": { "fill": "#18FFFFFF" } },
      "focused": { "background": { "fill": "#18FFFFFF", "border": "#FFFFFF", "borderWidth": 2 } },
      "pressed": { "background": { "fill": "#284CC2FF" } }
    },

    "table.row.alt": {
      "background": { "fill": "#0CFFFFFF" },
      "hovered": { "background": { "fill": "#18FFFFFF" } },
      "focused": { "background": { "fill": "#18FFFFFF", "border": "#FFFFFF", "borderWidth": 2 } },
      "pressed": { "background": { "fill": "#284CC2FF" } }
