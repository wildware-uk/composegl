    // colour rather than being hidden, because "you need 40 in Persuade" is worth knowing.

    "dialogue": {
      "background": { "fill": "#E6141B24", "corner": 8, "border": "#2A3440", "padding": [16, 14] }
    },
    "dialogue.speaker": { "textColour": "#F2C94C", "text": { "size": 18 } },
    "dialogue.text": { "textColour": "#E6EAF2" },
    "dialogue.choice": {
      "background": { "fill": "#1B222C", "corner": 5, "border": "#243140", "padding": [12, 8] },
