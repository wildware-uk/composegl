    },
    "dialogue.choice.reason": { "textColour": "#9AA4B2", "text": { "size": 13 } },
    "dialogue.timer.track": { "background": { "fill": "#0B1119", "corner": 2, "border": "#243140" } },
    "dialogue.timer.fill": { "background": { "fill": "#F2C94C", "corner": 2 } },
    "dialogue.control": {
      "background": { "fill": "#141B24", "corner": 4, "border": "#243140", "padding": [10, 4] },
      "textColour": "#9AA4B2",
      "text": { "size": 13 },
      "hovered": { "background": { "fill": "#243140", "corner": 4, "border": "#3A4756" } },
      "focused": { "background": { "fill": "#1C2632", "corner": 4, "border": "#4CC2FF" } },
      "pressed": {
        "background": { "fill": "#0B1119", "corner": 4, "border": "#243140" },
        "contentOffset": [0, 1]
      }
    },
    "dialogue.control.on": {
      "background": { "fill": "#2A6B8C", "corner": 4, "border": "#4CC2FF", "padding": [10, 4] },
      "textColour": "#E6EAF2",
      "text": { "size": 13 },
      "hovered": { "background": { "fill": "#3A87AF", "corner": 4, "border": "#8ADBFF" } },
      "focused": { "background": { "fill": "#2A6B8C", "corner": 4, "border": "#8ADBFF" } },
      "pressed": {
        "background": { "fill": "#1E4D66", "corner": 4, "border": "#2A6B8C" },
        "contentOffset": [0, 1]
      }
    },
    "dialogue.advance": { "textColour": "#4CC2FF" },
    "dialogue.history.speaker": { "textColour": "#F2C94C", "text": { "size": 14 } },
    "dialogue.history.line": { "textColour": "#E6EAF2", "text": { "size": 14 } },
    "dialogue.history.answer": { "textColour": "#4CC2FF", "text": { "size": 14 } },

    // The weapon wheel. The backdrop dims the world, because a wheel is modal; every other piece
    // has to stand clear of that backdrop or the wheel is a hole in the screen.
    "wheel.backdrop": { "background": { "fill": "#B00A0E14" } },
    "wheel.slice": { "background": { "fill": "#E61B2230" } },
    "wheel.slice.selected": { "background": { "fill": "#E62A3A52" } },
    "wheel.slice.highlighted": { "background": { "fill": "#F24CC2FF" } },
    "wheel.ring": { "background": { "fill": "#E6151B26" } },
    "wheel.ring.highlighted": { "background": { "fill": "#F28ADBFF" } },
    "wheel.hub": { "background": { "fill": "#F00A0E14" } },
    "wheel.label": { "textColour": "#E8F4FF", "text": { "size": 18 } },

    // --- the tools that sit over the game ---
    //
    // Smaller type than the game's own screens, because they are read up close. The window the keys
    // are going to is the one with a lit edge and a lit title bar.

    "debugwindow": { "background": { "fill": "#EE131820", "corner": 8, "border": "#2A3440", "padding": 1 } },
    "debugwindow.active": { "background": { "fill": "#F2131820", "corner": 8, "border": "#4CC2FF", "padding": 1 } },
    "debugwindow.title": {
      "background": { "fill": "#18FFFFFF", "corner": 7, "padding": [8, 4] },
      "textColour": "#9AA4B2",
      "text": { "size": 13 }
    },
    "debugwindow.title.active": {
      "background": { "fill": "#404CC2FF", "corner": 7, "padding": [8, 4] },
      "textColour": "#E6F4FF",
      "text": { "size": 13 }
    },
    "debugwindow.button": {
      "background": { "fill": "#00000000", "corner": 4, "padding": 3 },
      "textColour": "#9AA4B2",
      "hovered": { "background": { "fill": "#284CC2FF", "corner": 4 }, "textColour": "#FFFFFF" },
      "focused": { "background": { "fill": "#284CC2FF", "corner": 4, "border": "#FFFFFF", "borderWidth": 2 }, "textColour": "#FFFFFF" },
      "pressed": { "background": { "fill": "#404CC2FF", "corner": 4 } }
    },
    "debugwindow.body": { "padding": [10, 8] },
    "debugwindow.label": { "textColour": "#9AA4B2", "text": { "size": 13 } },
    "debugwindow.value": { "textColour": "#E6EAF2", "text": { "size": 13 } },
    "debugwindow.grip": { "background": { "fill": "#40FFFFFF", "corner": 2 } },

    // A live graph: a dark box with a bright trace on it, a wash underneath, and a dim rule across
    // it wherever the caller asked to be able to see.

    "plot": {
      "background": { "fill": "#0B1119", "corner": 6, "border": "#2A3440", "padding": [6, 4] },
      "textColour": "#C9D3E0"
    },
    "plot.label": { "textColour": "#6E8093", "text": { "size": 11 } },
    "plot.value": { "textColour": "#E6EAF2", "text": { "size": 11 } },
    "plot.line": { "textColour": "#4CC2FF" },
    "plot.fill": { "textColour": "#404CC2FF" },
    "plot.guide": { "textColour": "#3A4756" },
    "plot.cursor": { "textColour": "#FFB454" },
    "plot.bar": { "textColour": "#4CC2FF" },

    // The drop-down console: a panel over the top of the game with a log in it, one colour a level
    // so a warning is seen before it is read.

    "console": {
      "background": { "fill": "#F00B1119", "border": "#2A3440", "padding": 12 },
      "textColour": "#C9D3E0"
    },
    "console.title": { "textColour": "#6E8093", "text": { "size": 13 } },
    "console.prompt": { "textColour": "#4CC2FF" },

    "console.line": { "textColour": "#C9D3E0", "text": { "size": 14 } },
    "console.line.debug": { "textColour": "#7C8798", "text": { "size": 14 } },
    "console.line.info": { "textColour": "#C9D3E0", "text": { "size": 14 } },
    "console.line.warn": { "textColour": "#FFB454", "text": { "size": 14 } },
    "console.line.error": { "textColour": "#FF8080", "text": { "size": 14 } },
    "console.line.echo": { "textColour": "#8ADBFF", "text": { "size": 14 } },

    "console.suggestion": { "textColour": "#9AA4B2", "padding": [6, 2], "text": { "size": 14 } },
    "console.suggestion.selected": {
      "background": { "fill": "#404CC2FF", "corner": 4 },
      "textColour": "#E8F4FF",
      "padding": [6, 2],
      "text": { "size": 14 }
    },

    "console.field": {
      "background": { "fill": "#00000000", "padding": [2, 3] },
      "textColour": "#E8F4FF"
    },
    "console.field.placeholder": { "textColour": "#5A6675" },
    "console.field.caret": { "background": { "fill": "#E6F0FF" } },
    "console.field.selection": { "background": { "fill": "#504CC2FF" } },
    "console.field.composition": { "background": { "fill": "#8ADBFF" } }
  }
}
