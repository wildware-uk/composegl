    // --- more of the HUD ---

    "progress.track": { "background": { "fill": "#40000000", "corner": 4 } },
    "progress.fill": { "background": { "fill": "#4CC2FF", "corner": 4 } },
    "progress.fill.danger": { "background": { "fill": "#FF5C5C", "corner": 4 } },
    "progress.fill.good": { "background": { "fill": "#7BE08A", "corner": 4 } },

    "hitmarker": { "background": { "fill": "#FFFFFF" } },
    "hitmarker.critical": { "background": { "fill": "#FFD16A" } },
    "hitmarker.kill": { "background": { "fill": "#FF5A4F" } },

    // Both of these are drawn over the game itself, so both carry their own opacity: an arc the
