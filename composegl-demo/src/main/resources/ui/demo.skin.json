    },

    "menu.item": {
      "background": "none",
      "padding": [10, 5],
      "hovered": { "background": { "fill": "#284CC2FF", "corner": 5 } },
      "focused": { "background": { "fill": "#284CC2FF", "corner": 5, "border": "#FFFFFF", "borderWidth": 2 } },
      "pressed": { "background": { "fill": "#404CC2FF", "corner": 5 } },
      "disabled": { "textColour": "#5A6675" }
    },

    "menu.item.open": {
      "background": { "fill": "#404CC2FF", "corner": 5, "padding": [10, 5] }
    },

    "menu.shortcut": { "textColour": "#9AA4B2", "text": { "size": 13 } },
    "menu.separator": { "background": { "fill": "#30FFFFFF" } },
    "menu.check": { "background": { "fill": "#4CC2FF", "corner": 2 }, "disabled": { "tint": "#80FFFFFF" } },
    "menu.radio": { "background": { "fill": "#4CC2FF", "corner": 7 }, "disabled": { "tint": "#80FFFFFF" } },

    // --- selected text in a label ---

