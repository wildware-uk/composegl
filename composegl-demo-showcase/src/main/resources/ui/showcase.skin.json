      "focused": { "background": { "fill": "#304CC2FF", "corner": 3, "border": "#FFFFFF", "borderWidth": 2 } },
      "pressed": { "background": { "fill": "#504CC2FF", "corner": 3 } }
    },
    "debugwindow.tab.selected": {
      "background": { "fill": "#404CC2FF", "corner": 3, "padding": [8, 2] },
      "textColour": "#E6F4FF",
      "text": { "size": 13 },
      "hovered": { "background": { "fill": "#584CC2FF", "corner": 3 } },
      "focused": { "background": { "fill": "#404CC2FF", "corner": 3, "border": "#FFFFFF", "borderWidth": 2 } },
      "pressed": { "background": { "fill": "#584CC2FF", "corner": 3 } }
    },
    "debugwindow.dock": { "background": { "fill": "#404CC2FF", "corner": 4, "border": "#4CC2FF" } },
    "debugwindow.dock.target": { "background": { "fill": "#D90A1018", "corner": 3, "border": "#4CC2FF" } },
    "debugwindow.dock.target.active": { "background": { "fill": "#F24CC2FF", "corner": 3, "border": "#FFFFFF" } },

    // --- the graphs ---

    "plot": {
      "background": { "fill": "#060A12", "corner": 4, "border": "#2A3440", "padding": [6, 4] },
      "textColour": "#DCE6F2"
    },
    "plot.label": { "textColour": "#6E8093", "text": { "size": 13 } },
    "plot.value": { "textColour": "#E6F4FF", "text": { "size": 13 } },
    "plot.line": { "textColour": "#4CC2FF" },
    "plot.fill": { "textColour": "#404CC2FF" },
    "plot.guide": { "textColour": "#3A4756" },
    "plot.cursor": { "textColour": "#FFB454" },
    "plot.bar": { "textColour": "#4CC2FF" }
  }
}
