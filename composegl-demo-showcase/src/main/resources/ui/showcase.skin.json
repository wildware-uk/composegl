{
  // The showcase's skin.
  //
  // A combat HUD over a 3D scene: darker and thinner than the example's, because everything here
  // sits over a moving picture and has to stay readable without hiding it. Save it while the
  // showcase runs and it changes on the next frame.

  "defaults": {
    "textColour": "#DCE6F2",
    "text": { "font": "body", "size": 16 }
  },

  "styles": {

    // --- surfaces ---

    "panel": {
      "background": { "fill": "#C00A1018", "corner": 4, "border": "#404CC2FF", "padding": 16 }
    },

    "panel.quiet": {
      "background": { "fill": "#B00A1018", "corner": 4, "border": "#28FFFFFF", "padding": 16 }
    },

    // The readout pinned to a drone: no fill at all, because it is over the world.
    "tag": {
      "background": { "fill": "#800A1018", "corner": 3, "border": "#404CC2FF", "padding": [8, 5] }
    },

    // --- text ---

    "label": {},
    "label.dim": { "textColour": "#7E8DA3", "text": { "size": 13 } },
    "label.title": { "textColour": "#4CC2FF", "text": { "size": 20 } },
    "label.tag": { "textColour": "#8ADBFF", "text": { "size": 13 } },
    "label.holo": { "textColour": "#8AFFD8", "text": { "size": 16 } },

    // --- the things you press ---

    "button": {
      "background": { "fill": "#304CC2FF", "corner": 4, "border": "#4CC2FF", "padding": [14, 8] },
      "textColour": "#E6F4FF",
      "text": { "size": 13 },
      "hovered": { "background": { "fill": "#504CC2FF", "corner": 4, "border": "#8ADBFF", "borderWidth": 2 } },
      "pressed": { "background": { "fill": "#804CC2FF", "corner": 4, "border": "#8ADBFF", "borderWidth": 2 } },
      "focused": { "background": { "fill": "#304CC2FF", "corner": 4, "border": "#FFFFFF", "borderWidth": 2 } }
    },

    "toggle": {
      "background": { "fill": "#2000FFFF", "corner": 11, "border": "#404CC2FF", "padding": 3 },
      "hovered": { "background": { "fill": "#3000FFFF", "corner": 11, "border": "#4CC2FF" } },
      "focused": { "background": { "fill": "#2000FFFF", "corner": 11, "border": "#FFFFFF", "borderWidth": 2 } }
    },

    "toggle.on": {
      "background": { "fill": "#604CC2FF", "corner": 11, "border": "#8ADBFF", "padding": 3 },
      "hovered": { "background": { "fill": "#804CC2FF", "corner": 11, "border": "#8ADBFF" } },
      "focused": { "background": { "fill": "#604CC2FF", "corner": 11, "border": "#FFFFFF", "borderWidth": 2 } }
    },

    "toggle.knob": { "background": { "fill": "#E8F4FF", "corner": 8 } },

    // The splitter on the shader shelf: a faint blue bar that brightens under the pointer.

    "splitter": {
      "background": { "fill": "#304CC2FF", "corner": 3 },
      "hovered": { "background": { "fill": "#904CC2FF", "corner": 3 } },
      "pressed": { "background": { "fill": "#4CC2FF", "corner": 3 } },
      "focused": { "background": { "fill": "#904CC2FF", "corner": 3, "border": "#FFFFFF", "borderWidth": 2 } }
    },

    // The header the switches fold away under: a quiet strip, lit while it is open.

    "collapsingheader": {
      "background": { "fill": "#200A1018", "corner": 3, "padding": [6, 5] },
      "textColour": "#4CC2FF",
      "text": { "size": 18 },
      "hovered": { "background": { "fill": "#304CC2FF", "corner": 3 } },
      "pressed": { "background": { "fill": "#504CC2FF", "corner": 3 } },
      "focused": { "background": { "fill": "#200A1018", "corner": 3, "border": "#FFFFFF", "borderWidth": 2 } }
    },

    "collapsingheader.open": {
      "background": { "fill": "#204CC2FF", "corner": 3, "padding": [6, 5] },
      "textColour": "#4CC2FF",
      "text": { "size": 18 },
      "hovered": { "background": { "fill": "#304CC2FF", "corner": 3 } },
      "pressed": { "background": { "fill": "#504CC2FF", "corner": 3 } },
      "focused": { "background": { "fill": "#204CC2FF", "corner": 3, "border": "#FFFFFF", "borderWidth": 2 } }
    },

    "collapsingheader.glyph": { "textColour": "#8ADBFF", "focused": { "textColour": "#FFFFFF" } },
    "collapsingheader.body": { "padding": [0, 8] },

    // --- bars ---
    //
    // Hull is the one that matters, so it is the one that changes colour and pulses; heat is a
    // whole set of its own, which is what a game writes when it wants a second bar that is not
    // the first.

    "bar.track": { "background": { "fill": "#60000000", "corner": 3 } },
    "bar.fill": { "background": { "fill": "#4CC2FF", "corner": 3 } },
    "bar.fill.low": { "background": { "fill": "#FFB454", "corner": 3 } },
    "bar.fill.critical": { "background": { "fill": "#FF2B2B", "corner": 3 } },
    "bar.trail": { "background": { "fill": "#704CC2FF", "corner": 3 } },
    "bar.segment": { "background": { "fill": "#0A1018" } },

    "bar.heat.track": { "background": { "fill": "#60000000", "corner": 3 } },
    "bar.heat.fill": { "background": { "fill": "#FF7A45", "corner": 3 } },
    "bar.heat.trail": { "background": { "fill": "#70FF7A45", "corner": 3 } },
    "bar.heat.segment": { "background": { "fill": "#0A1018" } },

    "bar.shield.track": { "background": { "fill": "#60000000", "corner": 3 } },
    "bar.shield.fill": { "background": { "fill": "#8AFFD8", "corner": 3 } },
    "bar.shield.trail": { "background": { "fill": "#708AFFD8", "corner": 3 } },
    "bar.shield.segment": { "background": { "fill": "#0A1018" } },

    // The scanning readout while nothing is locked: the same blue as the bars, over the same dark track.

    "spinner": { "textColour": "#4CC2FF" },
    "spinner.track": { "textColour": "#304CC2FF" },
    "indeterminatebar.track": { "background": { "fill": "#60000000", "corner": 3 } },
    "indeterminatebar.fill": { "background": { "fill": "#4CC2FF", "corner": 3 } },

    // --- the ability bar ---

    "hotbar.slot": {
      "background": { "fill": "#800A1018", "corner": 4, "border": "#404CC2FF" },
      "textColour": "#9AA4B2",
      "text": { "size": 13 },
      "hovered": { "background": { "fill": "#304CC2FF", "corner": 4, "border": "#4CC2FF" } },
      "pressed": { "background": { "fill": "#604CC2FF", "corner": 4, "border": "#8ADBFF" } },
      "focused": { "background": { "fill": "#800A1018", "corner": 4, "border": "#FFFFFF", "borderWidth": 2 } }
    },

    "hotbar.slot.selected": {
      "background": { "fill": "#404CC2FF", "corner": 4, "border": "#4CC2FF", "borderWidth": 2 },
      "textColour": "#E6F4FF",
      "text": { "size": 13 }
    },

    "hotbar.slot.empty": {
      "background": { "fill": "#400A1018", "corner": 4, "border": "#20FFFFFF" }
    },

    "hotbar.prompt": { "textColour": "#6E8093", "text": { "size": 13 } },
    "hotbar.charges": { "textColour": "#FFFFFF", "text": { "size": 13 } },

    // --- the cargo grid ---
    //
    // An empty square is a hole in the hold and a square with something in it is a plate over that
    // hole, so the two read apart at a glance. The two footprints are the answer to "will it go
    // here?", given while the crate is still in the air.

    "inventory.cell": {
      "background": { "fill": "#400A1018", "corner": 3, "border": "#20FFFFFF" },
      "hovered": { "background": { "fill": "#304CC2FF", "corner": 3, "border": "#4CC2FF" } },
      "focused": { "background": { "fill": "#400A1018", "corner": 3, "border": "#FFFFFF", "borderWidth": 2 } }
    },

    "inventory.item": {
      "background": { "fill": "#900A1018", "corner": 3, "border": "#404CC2FF" },
      "textColour": "#DCE6F2",
      "text": { "size": 13 },
      "hovered": { "background": { "fill": "#304CC2FF", "corner": 3, "border": "#4CC2FF" } },
      "focused": { "background": { "fill": "#900A1018", "corner": 3, "border": "#FFFFFF", "borderWidth": 2 } }
    },

    "inventory.count": { "textColour": "#FFFFFF", "text": { "size": 12 } },
    "inventory.footprint": { "background": { "fill": "#5046A758", "corner": 3, "border": "#46A758" } },
    "inventory.footprint.invalid": { "background": { "fill": "#50E5484D", "corner": 3, "border": "#E5484D" } },
    "inventory.split": { "background": { "fill": "#F00A1018", "corner": 4, "border": "#4CC2FF" } },

    "cooldown.sweep": { "background": { "fill": "#B0060A12" } },
    "cooldown.flash": { "background": { "fill": "#804CC2FF" } },
    "cooldown.seconds": { "textColour": "#FFFFFF", "text": { "size": 16 } },

    // --- what a hit is worth ---

    "damage": { "textColour": "#FFE9A8", "text": { "size": 16 } },
    "damage.critical": { "textColour": "#FF7A45", "text": { "size": 20 } },

    // Being shot at: the arc that says which way it came from, and the ring that closes in as the
    // hull goes. Both carry their own opacity, because both are drawn over the scene itself.

    "damage.direction": { "background": { "fill": "#D0FF5A4F" } },
    "vignette": { "background": { "fill": "#E88B1519" } },

    // The triangle beside a drone tag being held at the edge of the screen, pointing at the drone.

    "marker.arrow": { "background": { "fill": "#4CC2FF" } },

    // --- the middle of the screen, and the radar ---

    "reticle": { "textColour": "#4CC2FF", "background": { "fill": "#E8ECF2" } },
    "reticle.hostile": { "background": { "fill": "#FF5A4F" } },
    "reticle.hit": { "background": { "fill": "#FFFFFF" } },
    "reticle.kill": { "background": { "fill": "#FF5A4F" } },

    "hitmarker": { "background": { "fill": "#FFFFFF" } },
    "hitmarker.critical": { "background": { "fill": "#FFD16A" } },
    "hitmarker.kill": { "background": { "fill": "#FF5A4F" } },

    "minimap": {
      "background": { "fill": "#B00A1018", "corner": 4, "border": "#404CC2FF", "padding": [7, 7] }
    },
    "minimap.marker": { "background": { "fill": "#4CC2FF" } },
    "minimap.compass": { "textColour": "#7E8DA3", "text": { "size": 13 } },

    "compass": {
      "background": { "fill": "#B00A1018", "corner": 4, "border": "#404CC2FF", "padding": [10, 5] }
    },
    "compass.tick": { "background": { "fill": "#5A6B80" } },
    "compass.label": { "textColour": "#E6F4FF", "text": { "size": 13 } },
    "compass.marker": { "background": { "fill": "#4CC2FF" } },
    "compass.pin": { "background": { "fill": "#7E8DA3" }, "textColour": "#7E8DA3", "text": { "size": 13 } },
    "compass.pin.locked": { "background": { "fill": "#FF5A4F" }, "textColour": "#FF5A4F", "text": { "size": 13 } },
    "compass.readout": { "textColour": "#4CC2FF", "text": { "size": 13 } },

    // The comms chatter. The band is opaque here and turned down by the player's own opacity
    // setting, so what the setting changes is this colour rather than two translucencies stacked.
    "subtitle": {
      "background": { "fill": "#0A1018", "corner": 4, "padding": [16, 10] },
      "textColour": "#E6F4FF",
      "text": { "size": 16 }
    },
    "subtitle.speaker": { "textColour": "#4CC2FF", "text": { "size": 16 } },
    "subtitle.caption": { "textColour": "#7E8DA3", "text": { "size": 16 } },

    // --- the comms channel ---
    //
    // A conversation along the bottom of the screen. Darker than a panel and wider than anything
    // else here, because it is the one thing on screen a player is reading rather than glancing at.

    "dialogue": {
      "background": { "fill": "#D8060B12", "corner": 4, "border": "#404CC2FF", "padding": [18, 14] }
    },
    "dialogue.speaker": { "textColour": "#4CC2FF", "text": { "size": 18 } },
    "dialogue.text": { "textColour": "#E6F4FF" },
    "dialogue.portrait": {
      "background": { "fill": "#300A1018", "corner": 4, "border": "#404CC2FF" }
    },

    "dialogue.choice": {
      "background": { "fill": "#200A1018", "corner": 4, "border": "#404CC2FF", "padding": [12, 8] },
      "textColour": "#DCE6F2",
      "text": { "size": 15 },
      "hovered": { "background": { "fill": "#404CC2FF", "corner": 4, "border": "#8ADBFF", "borderWidth": 2 } },
      "pressed": { "background": { "fill": "#704CC2FF", "corner": 4, "border": "#8ADBFF", "borderWidth": 2 } },
      "focused": { "background": { "fill": "#304CC2FF", "corner": 4, "border": "#FFFFFF", "borderWidth": 2 } },
      "disabled": { "textColour": "#5A6A80", "tint": "#A0FFFFFF" }
    },
    "dialogue.choice.reason": { "textColour": "#FFC24C", "text": { "size": 12 } },

    "dialogue.timer.track": { "background": { "fill": "#400A1018", "corner": 2, "border": "#404CC2FF" } },
    "dialogue.timer.fill": { "background": { "fill": "#4CC2FF", "corner": 2 } },

    "dialogue.control": {
      "background": { "fill": "#200A1018", "corner": 3, "border": "#404CC2FF", "padding": [10, 4] },
      "textColour": "#7E8DA3",
      "text": { "size": 12 },
      "hovered": { "background": { "fill": "#404CC2FF", "corner": 3, "border": "#8ADBFF" } },
      "focused": { "background": { "fill": "#304CC2FF", "corner": 3, "border": "#FFFFFF", "borderWidth": 2 } }
    },
    "dialogue.control.on": {
      "background": { "fill": "#604CC2FF", "corner": 3, "border": "#8ADBFF", "padding": [10, 4] },
      "textColour": "#E6F4FF",
      "text": { "size": 12 },
      "hovered": { "background": { "fill": "#804CC2FF", "corner": 3, "border": "#8ADBFF" } },
      "focused": { "background": { "fill": "#604CC2FF", "corner": 3, "border": "#FFFFFF", "borderWidth": 2 } }
    },
    "dialogue.advance": { "textColour": "#4CC2FF" },

    "dialogue.history.speaker": { "textColour": "#4CC2FF", "text": { "size": 14 } },
    "dialogue.history.line": { "textColour": "#DCE6F2", "text": { "size": 14 } },
    "dialogue.history.answer": { "textColour": "#8AFFD8", "text": { "size": 14 } },

    "focusRing": {
      "background": { "fill": "#00000000", "corner": 5, "border": "#FFFFFF", "padding": 3 }
    },

    "focusRing.hidden": { "background": "none", "padding": 3 },

    // --- the panel standing in the scene ---
    //
    // Drawn into a texture and added to the frame as light, so its background is deliberately
    // nearly black: what is dark here disappears, and what is bright glows.

    "holo": {
      "background": { "fill": "#E0030A10", "corner": 6, "border": "#608AFFD8", "padding": 18 }
    },

    // Added as light over a lit floor, so a hint has to be brighter than it would be on a screen.
    "holo.hint": { "textColour": "#8AFFD8", "text": { "size": 13 } },

    "holo.button": {
      "background": { "fill": "#308AFFD8", "corner": 4, "border": "#8AFFD8", "padding": [14, 8] },
      "textColour": "#D8FFF4",
      "text": { "size": 13 },
      "hovered": { "background": { "fill": "#608AFFD8", "corner": 4, "border": "#D8FFF4", "borderWidth": 2 } },
      "pressed": { "background": { "fill": "#908AFFD8", "corner": 4, "border": "#FFFFFF", "borderWidth": 2 } },
      "focused": { "background": { "fill": "#308AFFD8", "corner": 4, "border": "#FFFFFF", "borderWidth": 2 } }
    },

    // --- the developer console ---
    //
    // The drop-down console from composegl-debug, in the showcase's own blue. Dark enough to read
    // a log through and still see the scene moving behind it.

    "console": {
      "background": { "fill": "#E80A1018", "border": "#404CC2FF", "padding": 12 },
      "textColour": "#DCE6F2"
    },

    "console.title": { "textColour": "#7E8DA3", "text": { "size": 12 } },
    "console.prompt": { "textColour": "#4CC2FF" },

    "console.line": { "textColour": "#DCE6F2", "text": { "size": 14 } },
    "console.line.debug": { "textColour": "#7E8DA3", "text": { "size": 14 } },
    "console.line.info": { "textColour": "#DCE6F2", "text": { "size": 14 } },
    "console.line.warn": { "textColour": "#FFC24C", "text": { "size": 14 } },
    "console.line.error": { "textColour": "#FF7A6E", "text": { "size": 14 } },
    "console.line.echo": { "textColour": "#8ADBFF", "text": { "size": 14 } },

    "console.suggestion": { "textColour": "#8ADBFF", "padding": [6, 2], "text": { "size": 14 } },
    "console.suggestion.selected": {
      "background": { "fill": "#304CC2FF", "corner": 3 },
      "textColour": "#E6F4FF",
      "padding": [6, 2],
      "text": { "size": 14 }
    },

    "console.field": {
      "background": { "fill": "#00000000", "padding": [2, 3] },
      "textColour": "#E6F4FF"
    },
    "console.field.placeholder": { "textColour": "#5A6A80" },
    "console.field.caret": { "background": { "fill": "#4CC2FF" } },
    "console.field.selection": { "background": { "fill": "#504CC2FF" } },
    "console.field.composition": { "background": { "fill": "#7E8DA3" } }
  }
}
