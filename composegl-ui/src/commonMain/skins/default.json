{
  // The skin a game gets before it loads one of its own.
  //
  // Neutral, dark, and made of flat rounded boxes so that it needs no atlas and no artist: a game
  // that has written no skin still has a readable interface, and a game that is writing one has
  // something to change a piece at a time.
  //
  // This is an ordinary skin file. Nothing in the toolkit's code knows what colour a button is;
  // the build embeds this text, and it is read by the same loader a game's own file goes through.
  //
  // The palette, once, so that the rest of the file is obviously consistent:
  //
  //   #10131A  the screen behind everything    #E8ECF2  text
  //   #1A1F28  a panel                         #9BA6B6  text that is secondary
  //   #232A35  something raised off a panel    #5E6B7E  text that is unavailable
  //   #2C3545  a line, a border, a groove      #5B8DEF  the accent: focus, selection, progress
  //   #39445A  a raised thing, hovered         #E5484D  danger
  //                                            #46A758  good news

  "name": "Standard",

  "defaults": {
    "textColour": "#E8ECF2",
    "text": { "font": "default", "size": 16 }
  },

  "styles": {

    // --- surfaces ---

    "screen": { "background": { "fill": "#10131A" } },

    "panel": {
      "background": { "fill": "#1A1F28", "corner": 6, "border": "#2C3545", "padding": 12 }
    },

    "panel.raised": {
      "background": { "fill": "#232A35", "corner": 6, "border": "#39445A", "padding": 12 }
    },

    // A dialogue and the dimming behind it. The scrim is most of the effect: a panel that is
    // simply on top reads as another panel, and a panel over a darkened screen reads as a question.
    "dialog": {
      "background": { "fill": "#232A35", "corner": 8, "border": "#39445A", "padding": 18 }
    },

    "scrim": { "background": { "fill": "#B00A0D12" } },

    "separator": { "background": { "fill": "#2C3545" } },

    // The line Divider() draws between two sections. The widget decides how thick; this decides
    // what it looks like.
    "divider": { "background": { "fill": "#2C3545" } },

    // Working, for an unknown length of time. The spinner's arc is its text colour, turning over a
    // faint ring; the indeterminate bar's block slides along a track like a bar's.
    //
    // The track's padding is what keeps the block inside the groove rather than painted over its
    // edge: an indeterminate bar draws its block within the track's padding, so a track with an
    // outline and no padding is a track whose outline is rubbed out every time the block goes past.

    "spinner": { "textColour": "#5B8DEF" },
    "spinner.track": { "textColour": "#2C3545" },
    "indeterminatebar.track": { "background": { "fill": "#10131A", "corner": 3, "border": "#2C3545", "padding": 2 } },
    "indeterminatebar.fill": { "background": { "fill": "#5B8DEF", "corner": 3 } },

    "tooltip": {
      "background": { "fill": "#232A35", "corner": 4, "border": "#39445A", "padding": [8, 5] },
      "text": { "size": 14 }
    },

    // What the game is telling the player: the card, its second line, and the count of the ones
    // still waiting behind it.
    "notification": {
      "background": { "fill": "#232A35", "corner": 5, "border": "#4A5568", "padding": [12, 9] },
      "textColour": "#E8ECF2"
    },
    "notification.detail": { "textColour": "#9AA4B2", "text": { "size": 13 } },
    "notification.more": { "textColour": "#7C8798", "text": { "size": 13 } },

    // The chrome round a minimap. The frame's padding is the hole the game draws its map into.
    "minimap": {
      "background": { "fill": "#141922", "corner": 6, "border": "#4A5568", "padding": [6, 6] }
    },
    "minimap.marker": { "background": { "fill": "#F2C94C" } },
    "minimap.compass": { "textColour": "#9AA4B2", "text": { "size": 12 } },

    // The heading strip: the ruler it is drawn on, the names of the points, the line down the
    // middle saying which way the player is facing, and a pin with its distance under it.
    "compass": {
      "background": { "fill": "#141922", "corner": 4, "border": "#4A5568", "padding": [10, 5] }
    },
    "compass.tick": { "background": { "fill": "#6B7686" } },
    "compass.label": { "textColour": "#E8ECF2", "text": { "size": 13 } },
    "compass.marker": { "background": { "fill": "#5B8DEF" } },
    "compass.pin": { "background": { "fill": "#F2C94C" }, "textColour": "#9AA4B2", "text": { "size": 12 } },
    "compass.readout": { "textColour": "#5B8DEF", "text": { "size": 13 } },

    // Subtitles and captions: the band the words sit on, the speaker's name above them, and a
    // sound written down rather than spoken. The band is opaque here and made see-through by the
    // player's own opacity setting, so turning it down gives the colour this file chose rather
    // than two translucencies multiplied together.
    "subtitle": {
      "background": { "fill": "#0B0E14", "corner": 4, "padding": [16, 10] },
      "textColour": "#F2F5FA",
      "text": { "size": 16 }
    },
    "subtitle.speaker": { "textColour": "#5B8DEF", "text": { "size": 16 } },
    "subtitle.caption": { "textColour": "#C7D0DC", "text": { "size": 16 } },

    // A conversation: the box, the name over the line, the line itself, the answers to it, the bar
    // that runs out while the player thinks, the small Auto / Skip / Log buttons and the arrow that
    // says the line has finished. The box is slightly see-through, because a conversation happens
    // somewhere and the somewhere should still be there.
    "dialogue": {
      "background": { "fill": "#E61A1F28", "corner": 8, "border": "#39445A", "padding": [16, 14] }
    },
    "dialogue.speaker": { "textColour": "#F2C94C", "text": { "size": 18 } },
    "dialogue.text": { "textColour": "#E8ECF2" },

    "dialogue.choice": {
      "background": { "fill": "#232A35", "corner": 5, "border": "#2C3545", "padding": [12, 8] },
      "hovered": { "background": { "fill": "#39445A", "corner": 5, "border": "#4A5670" } },
      "focused": { "background": { "fill": "#2A3342", "corner": 5, "border": "#5B8DEF" } },
      "pressed": {
        "background": { "fill": "#1A1F28", "corner": 5, "border": "#2C3545" },
        "contentOffset": [0, 1]
      },
      "disabled": { "textColour": "#5E6B7E", "tint": "#A0FFFFFF" }
    },
    "dialogue.choice.reason": { "textColour": "#9AA4B2", "text": { "size": 13 } },

    "dialogue.timer.track": { "background": { "fill": "#10131A", "corner": 2, "border": "#2C3545" } },
    "dialogue.timer.fill": { "background": { "fill": "#F2C94C", "corner": 2 } },

    "dialogue.control": {
      "background": { "fill": "#1A1F28", "corner": 4, "border": "#2C3545", "padding": [10, 4] },
      "textColour": "#9BA6B6",
      "text": { "size": 13 },
      "hovered": { "background": { "fill": "#2C3545", "corner": 4, "border": "#4A5670" } },
      "focused": { "background": { "fill": "#2A3342", "corner": 4, "border": "#5B8DEF" } },
      "pressed": {
        "background": { "fill": "#10131A", "corner": 4, "border": "#2C3545" },
        "contentOffset": [0, 1]
      }
    },
    "dialogue.control.on": {
      "background": { "fill": "#3F6BD6", "corner": 4, "border": "#5B8DEF", "padding": [10, 4] },
      "textColour": "#E8ECF2",
      "text": { "size": 13 },
      "hovered": { "background": { "fill": "#5B8DEF", "corner": 4, "border": "#7BA5F5" } },
      "focused": { "background": { "fill": "#3F6BD6", "corner": 4, "border": "#7BA5F5" } },
      "pressed": {
        "background": { "fill": "#2C4C99", "corner": 4, "border": "#3F6BD6" },
        "contentOffset": [0, 1]
      }
    },
    "dialogue.advance": { "textColour": "#5B8DEF" },

    // The log a player opens when they were not paying attention.
    "dialogue.history.speaker": { "textColour": "#F2C94C", "text": { "size": 14 } },
    "dialogue.history.line": { "textColour": "#E8ECF2", "text": { "size": 14 } },
    "dialogue.history.answer": { "textColour": "#5B8DEF", "text": { "size": 14 } },

    // --- text ---

    "label": {
      "disabled": { "textColour": "#5E6B7E" }
    },
    "label.title": { "text": { "size": 22 } },
    "label.heading": { "text": { "size": 18 } },
    "label.dim": { "textColour": "#9BA6B6" },
    "label.danger": { "textColour": "#E5484D" },
    "label.good": { "textColour": "#46A758" },

    // --- buttons ---
    //
    // Four states, and the pressed one moves its contents a pixel: the cheapest convincing thing
    // in a game interface, and it belongs here rather than in a widget.

    "button": {
      "background": { "fill": "#232A35", "corner": 5, "border": "#2C3545", "padding": [14, 8] },
      "hovered": { "background": { "fill": "#39445A", "corner": 5, "border": "#4A5670" } },
      "focused": { "background": { "fill": "#2A3342", "corner": 5, "border": "#5B8DEF" } },
      "pressed": {
        "background": { "fill": "#1A1F28", "corner": 5, "border": "#2C3545" },
        "contentOffset": [0, 1]
      },
      "disabled": { "textColour": "#5E6B7E", "tint": "#A0FFFFFF" }
    },

    // A KeyBindButton waiting for a press. Amber rather than the focus blue, because "the next key
    // you press goes here" has to be impossible to miss on a list of twenty of them.
    "button.listening": {
      "background": { "fill": "#4A3A12", "corner": 5, "border": "#F0B429", "padding": [14, 8] },
      "textColour": "#F0B429"
    },

    "button.primary": {
      "background": { "fill": "#3F6BD6", "corner": 5, "border": "#5B8DEF", "padding": [14, 8] },
      "hovered": { "background": { "fill": "#5B8DEF", "corner": 5, "border": "#7BA5F5" } },
      "pressed": { "background": { "fill": "#2F53A8", "corner": 5, "border": "#3F6BD6" } }
    },

    "button.danger": {
      "background": { "fill": "#8E2B2E", "corner": 5, "border": "#E5484D", "padding": [14, 8] },
      "hovered": { "background": { "fill": "#B23539", "corner": 5, "border": "#F06066" } },
      "pressed": { "background": { "fill": "#6E2124", "corner": 5, "border": "#E5484D" } }
    },

    "button.quiet": {
      "background": "none",
      "textColour": "#9BA6B6",
      "padding": [10, 6],
      "hovered": { "textColour": "#E8ECF2", "background": { "fill": "#232A35", "corner": 5 } },
      "pressed": { "contentOffset": [0, 1] }
    },

    "button.icon": {
      "background": { "fill": "#232A35", "corner": 5, "border": "#2C3545", "padding": 6 },
      "hovered": { "background": { "fill": "#39445A", "corner": 5, "border": "#4A5670" } },
      "pressed": { "contentOffset": [0, 1] }
    },

    // --- things that take a value ---

    "checkbox": {
      "background": { "fill": "#10131A", "corner": 3, "border": "#39445A", "padding": 3 },
      "hovered": { "background": { "fill": "#1A1F28", "corner": 3, "border": "#5B8DEF" } },
      "focused": { "background": { "fill": "#10131A", "corner": 3, "border": "#5B8DEF" } }
    },

    "checkbox.tick": { "background": { "fill": "#5B8DEF", "corner": 2 } },

    "radio": {
      "background": { "fill": "#10131A", "corner": 8, "border": "#39445A", "padding": 3 },
      "hovered": { "background": { "fill": "#1A1F28", "corner": 8, "border": "#5B8DEF" } },
      "focused": { "background": { "fill": "#10131A", "corner": 8, "border": "#5B8DEF" } }
    },

    "radio.dot": { "background": { "fill": "#5B8DEF", "corner": 5 } },

    // A switch says which way it is by where its knob is, so the track only has to say on or off.
    // The knob is as tall as the track's padding leaves it: fatten the track here and the knob
    // follows without anybody editing a widget.

    "toggle": {
      "background": { "fill": "#10131A", "corner": 11, "border": "#39445A", "padding": 3 },
      "hovered": { "background": { "fill": "#1A1F28", "corner": 11, "border": "#5B8DEF" } },
      "focused": { "background": { "fill": "#10131A", "corner": 11, "border": "#5B8DEF", "borderWidth": 2 } },
      "disabled": { "tint": "#A0FFFFFF" }
    },

    "toggle.on": {
      "background": { "fill": "#2F53A8", "corner": 11, "border": "#5B8DEF", "padding": 3 },
      "hovered": { "background": { "fill": "#3F6BD6", "corner": 11, "border": "#7BA5F5" } },
      "focused": { "background": { "fill": "#2F53A8", "corner": 11, "border": "#7BA5F5", "borderWidth": 2 } },
      "disabled": { "tint": "#A0FFFFFF" }
    },

    "toggle.knob": { "background": { "fill": "#E8ECF2", "corner": 8 } },

    "slider.track": { "background": { "fill": "#2C3545", "corner": 3 } },
    "slider.fill": { "background": { "fill": "#5B8DEF", "corner": 3 } },
    "slider.knob": {
      "background": { "fill": "#E8ECF2", "corner": 8 },
      "hovered": { "background": { "fill": "#FFFFFF", "corner": 8 } },
      "focused": { "background": { "fill": "#FFFFFF", "corner": 8, "border": "#5B8DEF", "borderWidth": 2 } }
    },

    // A pan-and-zoom canvas is a window onto a world, so its own look is only the backdrop behind
    // that world and a ring when the pad has focus on the canvas itself.

    "panzoom": {
      "background": { "fill": "#0B0E14" },
      "focused": { "background": { "fill": "#0B0E14", "border": "#5B8DEF", "borderWidth": 2 } }
    },

    // A splitter's divider is a quiet bar between two panes that lights up when the pointer finds it,
    // so a player can see there is something to grab before the cursor tells them.

    "splitter": {
      "background": { "fill": "#1A1F28", "corner": 2 },
      "hovered": { "background": { "fill": "#39445A", "corner": 2 } },
      "pressed": { "background": { "fill": "#5B8DEF", "corner": 2 } },
      "focused": { "background": { "fill": "#39445A", "corner": 2, "border": "#5B8DEF", "borderWidth": 2 } },
      "disabled": { "tint": "#A0FFFFFF" }
    },

    // A colour picker: the panel round it, the frame round its square and strips (lit where focus
    // is), the ring and bars that mark the colour, and the checkerboard behind a see-through colour.
    // A swatch is a small framed square of colour that lights up like a button when it is one.

    "colourpicker": {
      "background": { "fill": "#1A1F28", "corner": 6, "border": "#2C3545", "padding": 10 }
    },
    "colourpicker.area": {
      "background": { "fill": "#10131A", "corner": 2, "border": "#2C3545" },
      "hovered": { "background": { "fill": "#10131A", "corner": 2, "border": "#4A5670" } },
      "focused": { "background": { "fill": "#10131A", "corner": 2, "border": "#5B8DEF", "borderWidth": 2 } },
      "disabled": { "tint": "#A0FFFFFF" }
    },
    "colourpicker.marker": { "background": { "fill": "#10131A" }, "textColour": "#FFFFFF" },
    "colourpicker.checker": { "background": { "fill": "#C8CCD2" }, "textColour": "#8A9099" },
    "colourswatch": {
      "background": { "fill": "#10131A", "corner": 3, "border": "#39445A", "padding": 2 },
      "hovered": { "background": { "fill": "#10131A", "corner": 3, "border": "#4A5670", "padding": 2 } },
      "focused": { "background": { "fill": "#10131A", "corner": 3, "border": "#5B8DEF", "borderWidth": 2, "padding": 2 } },
      "pressed": { "background": { "fill": "#10131A", "corner": 3, "border": "#5B8DEF", "padding": 2 } },
      "disabled": { "tint": "#A0FFFFFF" }
    },

    // A stepper is picked with left and right, so its arrows are what say it is one. An arrow at an
    // end it cannot pass is dimmed rather than hidden, so the value does not jump sideways.

    "stepper": {
      "background": { "fill": "#10131A", "corner": 5, "border": "#39445A", "padding": [2, 4] },
      "hovered": { "background": { "fill": "#1A1F28", "corner": 5, "border": "#5B8DEF" } },
      "focused": { "background": { "fill": "#10131A", "corner": 5, "border": "#5B8DEF", "borderWidth": 2 } },
      "disabled": { "tint": "#A0FFFFFF" }
    },

    "stepper.arrow": {
      "textColour": "#9BA6B6",
      "padding": [10, 2],
      "hovered": { "textColour": "#E8ECF2" },
      "focused": { "textColour": "#5B8DEF" },
      "pressed": { "textColour": "#FFFFFF", "contentOffset": [0, 1] },
      "disabled": { "textColour": "#39445A" }
    },

    "stepper.value": { "textColour": "#E8ECF2", "padding": [8, 2] },

    // A game's bar, which is a progress bar with a memory: the trail is the ghost of what was
    // there a moment ago, drawn behind the fill, and the segment is the notch between two blocks.

    "bar.track": { "background": { "fill": "#10131A", "corner": 3, "border": "#2C3545" } },
    "bar.fill": { "background": { "fill": "#46A758", "corner": 3 } },
    "bar.fill.low": { "background": { "fill": "#E8A33D", "corner": 3 } },
    "bar.fill.critical": { "background": { "fill": "#E5484D", "corner": 3 } },
    "bar.trail": { "background": { "fill": "#8E2B2E", "corner": 3 } },
    "bar.segment": { "background": { "fill": "#10131A" } },

    // A number flying off something that was hit. A critical is bigger as well as brighter: a
    // player reads the size before the colour.

    "damage": { "textColour": "#FFE9A8", "text": { "size": 18 } },
    "damage.critical": { "textColour": "#FF7A45", "text": { "size": 26 } },

    // The arc that says which way a hit came from, and the ring that closes in when the player is
    // nearly dead. Both carry their own opacity, because both are drawn over the game itself: an
    // arc a player cannot see past is worse than no arc at all.

    "damage.direction": { "background": { "fill": "#D8E5484D" } },
    "vignette": { "background": { "fill": "#E88B1519" } },

    // A marker pinned to a point in the world: a nameplate, a health bar over an enemy, a
    // waypoint. What is inside one is the game's own interface, so the only thing the layer draws
    // itself is the little triangle beside a marker it is holding at the edge of the screen,
    // turned to point at where the thing really is.

    "marker.arrow": { "background": { "fill": "#E8ECF2" } },

    // --- the hotbar ---
    //
    // An empty slot is a hole in the bar: no fill, a dashed-looking groove, nothing in it. A slot
    // with something in it that cannot be used right now is a full slot, dimmed. A player has to
    // be able to tell those two apart at a glance, so they are two different styles rather than
    // one style at two opacities.

    "hotbar.slot": {
      "background": { "fill": "#1A1F28", "corner": 6, "border": "#2C3545" },
      "hovered": { "background": { "fill": "#232A35", "corner": 6, "border": "#39445A" } },
      "focused": { "background": { "fill": "#232A35", "corner": 6, "border": "#5B8DEF", "borderWidth": 2 } },
      "disabled": { "textColour": "#5E6B7E", "tint": "#90FFFFFF" }
    },

    "hotbar.slot.selected": {
      "background": { "fill": "#2A3342", "corner": 6, "border": "#5B8DEF", "borderWidth": 2 },
      "hovered": { "background": { "fill": "#39445A", "corner": 6, "border": "#7BA5F5", "borderWidth": 2 } }
    },

    "hotbar.slot.empty": {
      "background": { "fill": "#0C0F15", "corner": 6, "border": "#1F2630" }
    },

    "hotbar.prompt": { "textColour": "#9BA6B6", "text": { "size": 12 } },
    "hotbar.charges": { "textColour": "#E8ECF2", "text": { "size": 12 } },

    // --- the inventory grid ---
    //
    // An empty square is a hole to put something in, and a square with something in it is a tile
    // over that hole, so the two read as different things at a glance rather than as one thing
    // with and without a picture. The two footprints are the answer to "will it go here?", given
    // before the player lets go: they are drawn over the squares, so both are see-through.

    "inventory.cell": {
      "background": { "fill": "#0C0F15", "corner": 4, "border": "#1F2630" },
      "hovered": { "background": { "fill": "#141922", "corner": 4, "border": "#39445A" } },
      "focused": { "background": { "fill": "#141922", "corner": 4, "border": "#5B8DEF", "borderWidth": 2 } }
    },

    "inventory.item": {
      "background": { "fill": "#1A1F28", "corner": 4, "border": "#2C3545" },
      "hovered": { "background": { "fill": "#232A35", "corner": 4, "border": "#39445A" } },
      "focused": { "background": { "fill": "#232A35", "corner": 4, "border": "#5B8DEF", "borderWidth": 2 } },
      "disabled": { "textColour": "#5E6B7E", "tint": "#90FFFFFF" }
    },

    "inventory.count": { "textColour": "#E8ECF2", "text": { "size": 12 } },
    "inventory.footprint": { "background": { "fill": "#5946A758", "corner": 4, "border": "#46A758" } },
    "inventory.footprint.invalid": { "background": { "fill": "#59E5484D", "corner": 4, "border": "#E5484D" } },

    "inventory.split": {
      "background": { "fill": "#141922", "corner": 6, "border": "#39445A" }
    },

    // An ability on cooldown. The wedge is a dark sheet over the icon rather than a colour of its
    // own, so it works over whatever art a game puts underneath it.

    "cooldown.sweep": { "background": { "fill": "#B0101319" } },
    "cooldown.flash": { "background": { "fill": "#70FFFFFF" } },
    "cooldown.seconds": { "textColour": "#E8ECF2", "text": { "size": 18 } },

    // The weapon wheel. The backdrop dims the world behind it, because a wheel is modal and a
    // player choosing a gun is not also aiming. The slice being pointed at is the accent: on a
    // wheel there is only ever one, so it can afford to be the loudest thing on screen.

    "wheel.backdrop": { "background": { "fill": "#99080A0E" } },
    "wheel.slice": { "background": { "fill": "#D91A1F28" } },
    "wheel.slice.selected": { "background": { "fill": "#D92A3342" } },
    "wheel.slice.highlighted": { "background": { "fill": "#F25B8DEF" } },
    "wheel.ring": { "background": { "fill": "#D9232A35" } },
    "wheel.ring.highlighted": { "background": { "fill": "#F27BA5F5" } },
    "wheel.hub": { "background": { "fill": "#E610131A" } },
    "wheel.label": { "textColour": "#E8ECF2", "text": { "size": 18 } },

    // The item card a looter reads on every pickup, and the equipped one beside it. The frame has
    // an edge because the edge is where the rarity colour goes; the card the new item is being
    // weighed against is the same box, sunk a shade, so the eye knows which of the two is the new
    // one without reading either.
    //
    // Green and red are the answer players expect, and the widget also draws an arrow and a sign,
    // so the colours here are reinforcement rather than the only thing carrying the meaning.

    "itemtip": {
      "background": { "fill": "#1A1F28", "corner": 5, "border": "#39445A", "borderWidth": 2, "padding": [10, 8] },
      "textColour": "#C7D0DC",
      "text": { "size": 13 }
    },
    "itemtip.compare": {
      "background": { "fill": "#10131A", "corner": 5, "border": "#2C3545", "borderWidth": 2, "padding": [10, 8] }
    },
    "itemtip.rarity": { "background": { "fill": "#5B8DEF" } },
    "itemtip.title": { "textColour": "#E8ECF2", "text": { "size": 16 } },
    "itemtip.subtitle": { "textColour": "#9AA4B2", "text": { "size": 12 } },
    "itemtip.label": { "textColour": "#9AA4B2", "text": { "size": 13 } },
    "itemtip.value": { "textColour": "#E8ECF2", "text": { "size": 13 } },
    "itemtip.better": { "textColour": "#5ED17A", "text": { "size": 13 } },
    "itemtip.worse": { "textColour": "#F0787C", "text": { "size": 13 } },
    "itemtip.same": { "textColour": "#8E9AAB", "text": { "size": 13 } },
    "itemtip.flavour": { "textColour": "#8E9AAB", "text": { "size": 12 } },
    "itemtip.hint": { "textColour": "#7C8798", "text": { "size": 12 } },

    // A skill tree. Four frames, one per state, because the whole point of the screen is telling
    // them apart at a glance: locked recedes into the backdrop, available is the accent asking to
    // be pressed, owned is settled and lit, and maxed is the warm colour nothing else uses. The
    // hold is a bright sweep over whichever node is being leaned on, and the lines are the same
    // three steps as the frames so a branch reads as open or shut from across the tree.

    "skilltree.plane": {
      "background": { "fill": "#0B0E14" },
      "focused": { "background": { "fill": "#0B0E14", "border": "#5B8DEF", "borderWidth": 2 } }
    },

    "skilltree.node.locked": {
      "background": { "fill": "#12161E", "corner": 8, "border": "#2C3545" },
      "textColour": "#6E7A92",
      "hovered": { "background": { "fill": "#1A1F28", "corner": 8, "border": "#39445A" } },
      "focused": { "background": { "fill": "#1A1F28", "corner": 8, "border": "#5B8DEF", "borderWidth": 2 } },
      "disabled": { "textColour": "#4A5670", "tint": "#90FFFFFF" }
    },

    "skilltree.node.available": {
      "background": { "fill": "#1D2634", "corner": 8, "border": "#5B8DEF", "borderWidth": 2 },
      "textColour": "#E8ECF2",
      "hovered": { "background": { "fill": "#27344A", "corner": 8, "border": "#7BA5F5", "borderWidth": 2 } },
      "pressed": { "background": { "fill": "#2E3D57", "corner": 8, "border": "#7BA5F5", "borderWidth": 2 } },
      "focused": { "background": { "fill": "#27344A", "corner": 8, "border": "#7BA5F5", "borderWidth": 2 } },
      "disabled": { "textColour": "#5E6B7E", "tint": "#90FFFFFF" }
    },

    "skilltree.node.owned": {
      "background": { "fill": "#20402F", "corner": 8, "border": "#4FBF7A", "borderWidth": 2 },
      "textColour": "#E8ECF2",
      "hovered": { "background": { "fill": "#295138", "corner": 8, "border": "#72D79A", "borderWidth": 2 } },
      "pressed": { "background": { "fill": "#2F5C41", "corner": 8, "border": "#72D79A", "borderWidth": 2 } },
      "focused": { "background": { "fill": "#295138", "corner": 8, "border": "#7BA5F5", "borderWidth": 2 } },
      "disabled": { "textColour": "#5E6B7E", "tint": "#90FFFFFF" }
    },

    "skilltree.node.maxed": {
      "background": { "fill": "#4A3A18", "corner": 8, "border": "#FFC864", "borderWidth": 2 },
      "textColour": "#FFF2D6",
      "hovered": { "background": { "fill": "#5A4720", "corner": 8, "border": "#FFD98F", "borderWidth": 2 } },
      "focused": { "background": { "fill": "#5A4720", "corner": 8, "border": "#7BA5F5", "borderWidth": 2 } },
      "disabled": { "textColour": "#9A8560", "tint": "#90FFFFFF" }
    },

    "skilltree.hold": { "background": { "fill": "#805B8DEF" } },
    "skilltree.rank": { "textColour": "#9BA6B6", "text": { "size": 12 } },

    "skilltree.edge.locked": { "background": { "fill": "#662C3545" } },
    "skilltree.edge.available": { "background": { "fill": "#CC5B8DEF" } },
    "skilltree.edge.owned": { "background": { "fill": "#CC4FBF7A" } },
    "skilltree.edge.fill": { "background": { "fill": "#FFB9F5CE" } },

    // The crosshair. Off-white rather than white, because a pure white crosshair disappears over
    // a bright sky; the hostile colour is the one thing on screen allowed to be that red.

    // The button a player is being asked to press. A skin with a button atlas overrides this per
    // button — "prompt.pad.south", "prompt.key.e" — and gets real art; this is what everything
    // else falls back to.

    "prompt": {
      "background": { "fill": "#39445A", "corner": 4, "border": "#6E7A92", "padding": [6, 0] },
      "textColour": "#E8ECF2",
      "text": { "size": 14 }
    },

    "reticle": { "background": { "fill": "#E8ECF2" } },
    "reticle.hostile": { "background": { "fill": "#FF5A4F" } },
    "reticle.hit": { "background": { "fill": "#FFFFFF" } },
    "reticle.kill": { "background": { "fill": "#FF5A4F" } },

    // The ticks that flash when a shot lands. A critical is warm and a kill is the same red the
    // crosshair uses for something hostile, so the two colours on this screen mean one thing each.

    "hitmarker": { "background": { "fill": "#FFFFFF" } },
    "hitmarker.critical": { "background": { "fill": "#FFD16A" } },
    "hitmarker.kill": { "background": { "fill": "#FF5A4F" } },

    "progress.track": { "background": { "fill": "#2C3545", "corner": 4 } },
    "progress.fill": { "background": { "fill": "#5B8DEF", "corner": 4 } },
    "progress.fill.danger": { "background": { "fill": "#E5484D", "corner": 4 } },
    "progress.fill.good": { "background": { "fill": "#46A758", "corner": 4 } },

    // --- typing ---

    "field": {
      "background": { "fill": "#10131A", "corner": 4, "border": "#2C3545", "padding": [10, 7] },
      "hovered": { "background": { "fill": "#10131A", "corner": 4, "border": "#39445A" } },
      "focused": {
        "background": { "fill": "#10131A", "corner": 4, "border": "#5B8DEF", "borderWidth": 2 }
      },
      "disabled": { "textColour": "#5E6B7E" }
    },

    "field.placeholder": { "textColour": "#5E6B7E" },
    "field.caret": { "background": { "fill": "#E8ECF2" } },
    "field.selection": { "background": { "fill": "#3F6BD6" } },
    "field.composition": { "background": { "fill": "#9BA6B6" } },

    // Selected text in a label, inside a SelectionContainer. The same blue as a field's.
    "selection": { "background": { "fill": "#3F6BD6" } },

    // The keyboard a pad player types with. A panel of buttons, tighter than a menu's, with Shift
    // lit in the accent while the next letter is a capital.

    "panel.keyboard": {
      "background": { "fill": "#1A1F28", "corner": 8, "border": "#39445A", "padding": 10 }
    },

    "button.key": {
      "background": { "fill": "#232A35", "corner": 4, "border": "#2C3545", "padding": [4, 7] },
      "hovered": { "background": { "fill": "#39445A", "corner": 4, "border": "#4A5670" } },
      "focused": { "background": { "fill": "#2F53A8", "corner": 4, "border": "#7BA5F5", "borderWidth": 2 } },
      "pressed": {
        "background": { "fill": "#1A1F28", "corner": 4, "border": "#2C3545" },
        "contentOffset": [0, 1]
      },
      "disabled": { "textColour": "#5E6B7E", "tint": "#A0FFFFFF" }
    },

    "button.key.on": {
      "background": { "fill": "#3F6BD6", "corner": 4, "border": "#5B8DEF", "padding": [4, 7] },
      "focused": { "background": { "fill": "#5B8DEF", "corner": 4, "border": "#E8ECF2", "borderWidth": 2 } }
    },

    // --- lists and menus ---

    "item": {
      "background": "none",
      "padding": [10, 6],
      "hovered": { "background": { "fill": "#232A35", "corner": 4 } },
      "focused": { "background": { "fill": "#232A35", "corner": 4, "border": "#5B8DEF" } },
      "pressed": { "background": { "fill": "#2C3545", "corner": 4 } },
      "disabled": { "textColour": "#5E6B7E" }
    },

    "item.selected": {
      "background": { "fill": "#2F53A8", "corner": 4, "padding": [10, 6] },
      "hovered": { "background": { "fill": "#3F6BD6", "corner": 4 } }
    },

    // A dropdown is a field that opens a list. Closed, it looks like something you can type into
    // rather than a button, because it holds a value; its list is a raised panel of "item"s.

    "dropdown": {
      "background": { "fill": "#10131A", "corner": 4, "border": "#39445A", "padding": [10, 7] },
      "hovered": { "background": { "fill": "#1A1F28", "corner": 4, "border": "#4A5670" } },
      "focused": { "background": { "fill": "#10131A", "corner": 4, "border": "#5B8DEF", "borderWidth": 2 } },
      "pressed": { "background": { "fill": "#1A1F28", "corner": 4, "border": "#5B8DEF" } },
      "disabled": { "textColour": "#5E6B7E" }
    },

    "dropdown.list": {
      "background": { "fill": "#232A35", "corner": 4, "border": "#39445A", "padding": 4 }
    },

    // A collapsing header is a section's title bar that folds the section away. Lit a step while
    // open, so a column of them says which are open before anybody reads the triangles; the body's
    // padding is how far the contents sit in under it.

    "collapsingheader": {
      "background": { "fill": "#1A1F28", "corner": 4, "padding": [8, 6] },
      "hovered": { "background": { "fill": "#232A35", "corner": 4 } },
      "focused": { "background": { "fill": "#1A1F28", "corner": 4, "border": "#5B8DEF" } },
      "pressed": { "background": { "fill": "#2C3545", "corner": 4 } },
      "disabled": { "textColour": "#5E6B7E" }
    },

    "collapsingheader.open": {
      "background": { "fill": "#232A35", "corner": 4, "padding": [8, 6] },
      "hovered": { "background": { "fill": "#2C3545", "corner": 4 } },
      "focused": { "background": { "fill": "#232A35", "corner": 4, "border": "#5B8DEF" } },
      "pressed": { "background": { "fill": "#39445A", "corner": 4 } },
      "disabled": { "textColour": "#5E6B7E" }
    },

    "collapsingheader.glyph": {
      "textColour": "#9BA6B6",
      "hovered": { "textColour": "#E8ECF2" },
      "focused": { "textColour": "#5B8DEF" },
      "disabled": { "textColour": "#39445A" }
    },

    "collapsingheader.body": { "padding": [12, 6] },

    // --- tables ---
    //
    // A table is a panel with a strip of titles across the top. Every other row is a shade lighter
    // so a long line of numbers can be followed across, the chosen row is the accent, and the
    // divider between two titles is a hairline that lights up when the pointer finds it. Rows and
    // the header have no padding of their own: the cells carry it, so titles and values line up.

    "table": { "background": { "fill": "#1A1F28", "corner": 4, "border": "#2C3545", "padding": 2 } },
    "table.header": { "background": { "fill": "#232A35" } },

    "table.header.cell": {
      "background": "none",
      "textColour": "#9BA6B6",
      "padding": [8, 6],
      "text": { "size": 14 },
      "hovered": { "background": { "fill": "#2C3545" }, "textColour": "#E8ECF2" },
      "focused": { "background": { "fill": "#2C3545", "border": "#5B8DEF" }, "textColour": "#E8ECF2" },
      "pressed": { "background": { "fill": "#39445A" } }
    },

    "table.header.cell.sorted": {
      "background": "none",
      "textColour": "#E8ECF2",
      "padding": [8, 6],
      "text": { "size": 14 },
      "hovered": { "background": { "fill": "#2C3545" } },
      "focused": { "background": { "fill": "#2C3545", "border": "#5B8DEF" } },
      "pressed": { "background": { "fill": "#39445A" } }
    },

    // The grab area is nine wide; the padding is what is left either side of the line drawn in it.
    "table.divider": {
      "background": { "fill": "#39445A" },
      "padding": [4, 6],
      "hovered": { "background": { "fill": "#5B8DEF" } },
      "pressed": { "background": { "fill": "#7BA5F5" } }
    },

    "table.row": {
      "background": "none",
      "hovered": { "background": { "fill": "#232A35" } },
      "focused": { "background": { "fill": "#232A35", "border": "#5B8DEF" } },
      "pressed": { "background": { "fill": "#2C3545" } }
    },

    "table.row.alt": {
      "background": { "fill": "#1E242E" },
      "hovered": { "background": { "fill": "#232A35" } },
      "focused": { "background": { "fill": "#232A35", "border": "#5B8DEF" } },
      "pressed": { "background": { "fill": "#2C3545" } }
    },

    "table.row.selected": {
      "background": { "fill": "#2F53A8" },
      "hovered": { "background": { "fill": "#3F6BD6" } },
      "focused": { "background": { "fill": "#2F53A8", "border": "#7BA5F5" } }
    },

    "table.cell": { "padding": [8, 5] },
    "table.empty": { "textColour": "#9BA6B6", "padding": 16 },

    // --- menus ---
    //
    // A menu bar is a strip of quiet titles, and the one whose menu is open is lit so the menu hanging
    // under it is plainly its own. The menu is a raised panel of rows; the shortcut column is dimmer
    // than the label, because it is a reminder and not the thing being chosen.

    "menubar": { "background": { "fill": "#1A1F28", "border": "#2C3545", "padding": [4, 2] } },

    "menubar.title": {
      "background": { "fill": "#00000000", "corner": 4, "padding": [10, 5] },
      "hovered": { "background": { "fill": "#232A35", "corner": 4 } },
      "focused": { "background": { "fill": "#232A35", "corner": 4, "border": "#5B8DEF" } },
      "pressed": { "background": { "fill": "#2C3545", "corner": 4 } },
      "disabled": { "textColour": "#5E6B7E" }
    },

    "menubar.title.open": {
      "background": { "fill": "#2F53A8", "corner": 4, "padding": [10, 5] },
      "focused": { "background": { "fill": "#2F53A8", "corner": 4, "border": "#7BA5F5" } }
    },

    "menu": {
      "background": { "fill": "#232A35", "corner": 4, "border": "#39445A", "padding": 4 }
    },

    "menu.item": {
      "background": "none",
      "padding": [10, 5],
      "hovered": { "background": { "fill": "#2C3545", "corner": 3 } },
      "focused": { "background": { "fill": "#2C3545", "corner": 3, "border": "#5B8DEF" } },
      "pressed": { "background": { "fill": "#39445A", "corner": 3 } },
      "disabled": { "textColour": "#5E6B7E" }
    },

    "menu.item.open": {
      "background": { "fill": "#2C3545", "corner": 3, "padding": [10, 5] }
    },

    "menu.shortcut": { "textColour": "#9BA6B6", "text": { "size": 14 } },
    "menu.separator": { "background": { "fill": "#39445A" } },
    "menu.check": {
      "background": { "fill": "#5B8DEF", "corner": 2 },
      "disabled": { "tint": "#80FFFFFF" }
    },
    "menu.radio": {
      "background": { "fill": "#5B8DEF", "corner": 7 },
      "disabled": { "tint": "#80FFFFFF" }
    },

    // --- debug windows ---
    //
    // The floating tool windows from composegl-debug. Smaller type than a game's screens, because they
    // sit over the game and are read up close. The window focus is in lights its edge and its title bar,
    // so a player with three open can see which one the keys are going to.

    "debugwindow": { "background": { "fill": "#EE1A1F28", "corner": 5, "border": "#39445A", "padding": 1 } },
    "debugwindow.active": { "background": { "fill": "#F21A1F28", "corner": 5, "border": "#5B8DEF", "padding": 1 } },
    "debugwindow.title": {
      "background": { "fill": "#232A35", "corner": 4, "padding": [6, 4] },
      "textColour": "#9BA6B6",
      "text": { "size": 14 }
    },
    "debugwindow.title.active": {
      "background": { "fill": "#2F53A8", "corner": 4, "padding": [6, 4] },
      "textColour": "#E8ECF2",
      "text": { "size": 14 }
    },
    "debugwindow.button": {
      "background": { "fill": "#00000000", "corner": 3, "padding": 3 },
      "textColour": "#C5CDD8",
      "hovered": { "background": { "fill": "#39445A", "corner": 3 }, "textColour": "#FFFFFF" },
      "focused": { "background": { "fill": "#39445A", "corner": 3, "border": "#5B8DEF" }, "textColour": "#FFFFFF" },
      "pressed": { "background": { "fill": "#4A5670", "corner": 3 } }
    },
    "debugwindow.body": { "padding": [8, 6] },
    "debugwindow.label": { "textColour": "#9BA6B6", "text": { "size": 14 } },
    "debugwindow.value": { "textColour": "#E8ECF2", "text": { "size": 14 } },
    "debugwindow.grip": { "background": { "fill": "#39445A", "corner": 2 } },

    // --- trees ---
    //
    // Rows as quiet as a list's until they are hovered or chosen. The arrow is dimmer than the words,
    // and the indent guides dimmer still: they are there to be followed, not read.

    "tree.row": {
      "background": "none",
      "padding": [6, 3],
      "hovered": { "background": { "fill": "#232A35", "corner": 3 } },
      "focused": { "background": { "fill": "#232A35", "corner": 3, "border": "#5B8DEF" } },
      "pressed": { "background": { "fill": "#2C3545", "corner": 3 } },
      "disabled": { "textColour": "#5E6B7E" }
    },

    "tree.row.selected": {
      "background": { "fill": "#2F53A8", "corner": 3, "padding": [6, 3] },
      "hovered": { "background": { "fill": "#3F6BD6", "corner": 3 } },
      "focused": { "background": { "fill": "#2F53A8", "corner": 3, "border": "#7BA5F5" } }
    },

    "tree.toggle": { "textColour": "#9BA6B6", "hovered": { "textColour": "#FFFFFF" } },
    "tree.toggle.open": { "textColour": "#9BA6B6", "hovered": { "textColour": "#FFFFFF" } },
    "tree.guide": { "background": { "fill": "#39445A" } },

    // --- tabs ---
    //
    // A heading rather than a button: flat until it is the chosen one, which is the one thing a
    // player reads off a row of tabs at a glance.

    "tab": {
      "background": { "fill": "#00000000", "corner": 4, "padding": [12, 6] },
      "textColour": "#9BA6B6",
      "hovered": { "background": { "fill": "#1A1F28", "corner": 4 }, "textColour": "#E6E9EF" },
      "focused": { "background": { "fill": "#1A1F28", "corner": 4, "border": "#5B8DEF", "borderWidth": 2 } },
      "disabled": { "textColour": "#5E6B7E" }
    },

    "tab.selected": {
      "background": { "fill": "#232A35", "corner": 4, "border": "#5B8DEF", "padding": [12, 6] },
      "textColour": "#E6E9EF",
      "hovered": { "background": { "fill": "#2C3545", "corner": 4, "border": "#7BA5F5" } },
      "focused": { "background": { "fill": "#232A35", "corner": 4, "border": "#7BA5F5", "borderWidth": 2 } }
    },

    "scrollbar.track": { "background": { "fill": "#1A1F28", "corner": 4 } },
    "scrollbar.thumb": {
      "background": { "fill": "#39445A", "corner": 4 },
      "hovered": { "background": { "fill": "#4A5670", "corner": 4 } }
    },

    // --- the pad's cursor ---
    //
    // On a console this ring is not decoration, it is the only thing telling a player where they
    // are, so it is bright and it is its own style for a game to make brighter.

    "focusRing": {
      "background": { "fill": "#00000000", "corner": 6, "border": "#5B8DEF", "borderWidth": 2 }
    },

    // --- live plots ---
    //
    // The graphs in composegl-debug: a frame time, a ping, a count per bucket. A dark box with a
    // bright trace on it, a translucent wash underneath and a dim rule across it at whatever value
    // the caller asked to be able to see. The box is padded because the readout is written in its
    // corners, over the graph.

    "plot": {
      "background": { "fill": "#0E1117", "border": "#2C3545", "padding": [6, 4] },
      "textColour": "#C9D3E0"
    },

    "plot.label": { "textColour": "#7C8798", "text": { "size": 11 } },
    "plot.value": { "textColour": "#E8ECF2", "text": { "size": 11 } },

    "plot.line": { "textColour": "#7FB0FF" },
    "plot.fill": { "textColour": "#402B7FFF" },
    "plot.guide": { "textColour": "#4A5567" },
    "plot.cursor": { "textColour": "#E8A33D" },
    "plot.bar": { "textColour": "#7FB0FF" },

    // --- the developer console ---
    //
    // The drop-down console in composegl-debug: a panel over the top of the game with a log in it,
    // one colour a level so a warning is seen before it is read. Its prompt has a field style of
    // its own rather than the plain one, because a console's prompt is a line with a caret on it
    // rather than a box on a form.

    "console": {
      "background": { "fill": "#0E1117", "border": "#2C3545", "padding": 10 },
      "textColour": "#C9D3E0"
    },

    "console.title": { "textColour": "#7C8798", "text": { "size": 13 } },
    "console.prompt": { "textColour": "#5B8DEF" },

    "console.line": { "textColour": "#C9D3E0", "text": { "size": 14 } },
    "console.line.debug": { "textColour": "#8A93A3", "text": { "size": 14 } },
    "console.line.info": { "textColour": "#C9D3E0", "text": { "size": 14 } },
    "console.line.warn": { "textColour": "#E8A33D", "text": { "size": 14 } },
    "console.line.error": { "textColour": "#FF7B7E", "text": { "size": 14 } },
    "console.line.echo": { "textColour": "#7FB0FF", "text": { "size": 14 } },

    "console.suggestion": { "textColour": "#9BA6B6", "padding": [6, 2], "text": { "size": 14 } },
    "console.suggestion.selected": {
      "background": { "fill": "#233047", "corner": 3 },
      "textColour": "#E8ECF2",
      "padding": [6, 2],
      "text": { "size": 14 }
    },

    "console.field": {
      "background": { "fill": "#00000000", "padding": [2, 3] },
      "textColour": "#E8ECF2"
    },
    "console.field.placeholder": { "textColour": "#5E6B7E" },
    "console.field.caret": { "background": { "fill": "#E8ECF2" } },
    "console.field.selection": { "background": { "fill": "#3F6BD6" } },
    "console.field.composition": { "background": { "fill": "#9BA6B6" } }
  }
}
