{
  // The default skin for a player who needs to see it more clearly.
  //
  // Every style the default skin names, in the same shapes, so a widget laid out in one does not
  // move in the other — only what it is drawn with changes. That is what lets a game switch skins
  // from an options screen without the options screen jumping under the player's cursor.
  //
  //   #000000  every surface                  #FFFFFF  text, and the edge of everything
  //   #333333  a thing under the pointer      #B0B0B0  a quieter edge, and unavailable text
  //   #FFD600  focus, and the thing you are   #2C6BD6  the blue a chosen row is filled with
  //            pointing at                             (light enough to be seen on the black,
  //   #FF5050  danger                                  dark enough to read white words on)
  //   #00E060  good news
  //
  // Borders are two pixels throughout, and the focus ring is yellow: on a console focus is the only
  // cursor, and this is the skin for a player who could not find the blue one.

  "name": "High contrast",

  "defaults": {
    "textColour": "#FFFFFF",
    "text": { "font": "default", "size": 16 }
  },

  "styles": {

    // --- surfaces ---

    "screen": { "background": { "fill": "#000000" } },

    "panel": {
      "background": { "fill": "#000000", "corner": 6, "border": "#FFFFFF", "padding": 12, "borderWidth": 2 }
    },

    "panel.raised": {
      "background": { "fill": "#000000", "corner": 6, "border": "#B0B0B0", "padding": 12, "borderWidth": 2 }
    },

    // A dialogue and the dimming behind it. The scrim is most of the effect: a panel that is
    // simply on top reads as another panel, and a panel over a darkened screen reads as a question.
    "dialog": {
      "background": { "fill": "#000000", "corner": 8, "border": "#FFFFFF", "padding": 18, "borderWidth": 2 }
    },

    "scrim": { "background": { "fill": "#D8000000" } },

    "separator": { "background": { "fill": "#FFFFFF" } },

    // The line Divider() draws between two sections. The widget decides how thick; this decides
    // what it looks like.
    "divider": { "background": { "fill": "#FFFFFF" } },

    // Working, for an unknown length of time: a yellow arc turning over a grey ring, and a yellow
    // block sliding along a white-edged track. The track's padding is the room its own outline
    // needs — without it the block paints straight over the white edge as it goes past.

    "spinner": { "textColour": "#FFD600" },
    "spinner.track": { "textColour": "#404040" },
    "indeterminatebar.track": { "background": { "fill": "#000000", "corner": 3, "border": "#FFFFFF", "borderWidth": 2, "padding": 2 } },
    "indeterminatebar.fill": { "background": { "fill": "#FFD600", "corner": 3 } },

    "tooltip": {
      "background": { "fill": "#000000", "corner": 4, "border": "#FFFFFF", "padding": [8, 5], "borderWidth": 2 },
      "text": { "size": 14 }
    },

    // What the game is telling the player: the card, its second line, and the count of the ones
    // still waiting behind it.
    "notification": {
      "background": { "fill": "#000000", "corner": 5, "border": "#FFFFFF", "padding": [12, 9], "borderWidth": 2 },
      "textColour": "#FFFFFF"
    },
    "notification.detail": { "textColour": "#FFFFFF", "text": { "size": 13 } },
    "notification.more": { "textColour": "#FFFFFF", "text": { "size": 13 } },

    // The chrome round a minimap. The frame's padding is the hole the game draws its map into.
    "minimap": {
      "background": { "fill": "#000000", "corner": 6, "border": "#FFFFFF", "padding": [6, 6], "borderWidth": 2 }
    },
    "minimap.marker": { "background": { "fill": "#FFD600" } },
    "minimap.compass": { "textColour": "#FFFFFF", "text": { "size": 12 } },

    // The heading strip. The same sizes as the default's, so switching skins does not move a name.
    "compass": {
      "background": { "fill": "#000000", "corner": 4, "border": "#FFFFFF", "padding": [10, 5], "borderWidth": 2 }
    },
    "compass.tick": { "background": { "fill": "#FFFFFF" } },
    "compass.label": { "textColour": "#FFFFFF", "text": { "size": 13 } },
    "compass.marker": { "background": { "fill": "#FFD600" } },
    "compass.pin": { "background": { "fill": "#FFD600" }, "textColour": "#FFFFFF", "text": { "size": 12 } },
    "compass.readout": { "textColour": "#FFD600", "text": { "size": 13 } },

    // Subtitles. The same sizes and padding as the default's, so switching skins does not rewrap a
    // line in the middle of a conversation.
    "subtitle": {
      "background": { "fill": "#000000", "corner": 4, "padding": [16, 10] },
      "textColour": "#FFFFFF",
      "text": { "size": 16 }
    },
    "subtitle.speaker": { "textColour": "#FFD600", "text": { "size": 16 } },
    "subtitle.caption": { "textColour": "#FFFFFF", "text": { "size": 16 } },

    // A conversation. The same sizes as the default's, so switching skins does not move a line or
    // the answer the player is standing on — but the box is solid here rather than see-through,
    // because words over a moving scene are the hardest thing on the screen to read.
    "dialogue": {
      "background": { "fill": "#000000", "corner": 8, "border": "#FFFFFF", "padding": [16, 14], "borderWidth": 2 }
    },
    "dialogue.speaker": { "textColour": "#FFD600", "text": { "size": 18 } },
    "dialogue.text": { "textColour": "#FFFFFF" },

    "dialogue.choice": {
      "background": { "fill": "#000000", "corner": 5, "border": "#FFFFFF", "padding": [12, 8], "borderWidth": 2 },
      "hovered": { "background": { "fill": "#333333", "corner": 5, "border": "#FFFFFF", "borderWidth": 2 } },
      "focused": { "background": { "fill": "#000000", "corner": 5, "border": "#FFD600", "borderWidth": 2 } },
      "pressed": {
        "background": { "fill": "#000000", "corner": 5, "border": "#FFFFFF", "borderWidth": 2 },
        "contentOffset": [0, 1]
      },
      "disabled": { "textColour": "#B0B0B0", "tint": "#A0FFFFFF" }
    },
    "dialogue.choice.reason": { "textColour": "#FFFFFF", "text": { "size": 13 } },

    "dialogue.timer.track": { "background": { "fill": "#000000", "corner": 2, "border": "#FFFFFF", "borderWidth": 2 } },
    "dialogue.timer.fill": { "background": { "fill": "#FFD600", "corner": 2 } },

    "dialogue.control": {
      "background": { "fill": "#000000", "corner": 4, "border": "#FFFFFF", "padding": [10, 4], "borderWidth": 2 },
      "textColour": "#FFFFFF",
      "text": { "size": 13 },
      "hovered": { "background": { "fill": "#333333", "corner": 4, "border": "#FFFFFF", "borderWidth": 2 } },
      "focused": { "background": { "fill": "#000000", "corner": 4, "border": "#FFD600", "borderWidth": 2 } },
      "pressed": {
        "background": { "fill": "#000000", "corner": 4, "border": "#FFFFFF", "borderWidth": 2 },
        "contentOffset": [0, 1]
      }
    },
    "dialogue.control.on": {
      "background": { "fill": "#0033AA", "corner": 4, "border": "#FFD600", "padding": [10, 4], "borderWidth": 2 },
      "textColour": "#FFFFFF",
      "text": { "size": 13 },
      "hovered": { "background": { "fill": "#0044CC", "corner": 4, "border": "#FFE866", "borderWidth": 2 } },
      "focused": { "background": { "fill": "#0033AA", "corner": 4, "border": "#FFD600", "borderWidth": 2 } },
      "pressed": {
        "background": { "fill": "#002277", "corner": 4, "border": "#FFD600", "borderWidth": 2 },
        "contentOffset": [0, 1]
      }
    },
    "dialogue.advance": { "textColour": "#FFD600" },

    // The log a player opens when they were not paying attention.
    "dialogue.history.speaker": { "textColour": "#FFD600", "text": { "size": 14 } },
    "dialogue.history.line": { "textColour": "#FFFFFF", "text": { "size": 14 } },
    "dialogue.history.answer": { "textColour": "#FFD600", "text": { "size": 14 } },

    // The objective list. Solid rather than see-through here, for the reason the dialogue box is:
    // words over a moving scene are the hardest thing on the screen to read. A finished step is
    // still the dimmest thing on the list, and still well above the readable bar.
    "objective": {
      "background": { "fill": "#000000", "corner": 5, "border": "#FFFFFF", "padding": [12, 10], "borderWidth": 2 }
    },
    "objective.title": { "textColour": "#FFD600", "text": { "size": 15 } },
    "objective.step": { "textColour": "#FFFFFF", "text": { "size": 14 } },
    "objective.step.done": { "textColour": "#B0B0B0", "text": { "size": 14 } },
    "objective.bullet": { "background": { "fill": "#000000", "corner": 3, "border": "#FFFFFF", "borderWidth": 2 } },
    "objective.tick": { "background": { "fill": "#00E060" } },
    "objective.count": { "textColour": "#FFFFFF", "text": { "size": 13 } },
    "objective.more": {
      "background": { "fill": "#00000000", "corner": 4, "padding": [4, 2] },
      "textColour": "#FFFFFF",
      "text": { "size": 13 },
      "hovered": { "background": { "fill": "#333333", "corner": 4 }, "textColour": "#FFFFFF" },
      "focused": { "background": { "fill": "#000000", "corner": 4, "border": "#FFD600", "borderWidth": 2 } },
      "pressed": { "background": { "fill": "#000000", "corner": 4 }, "contentOffset": [0, 1] }
    },

    // In-game chat. The panel is solid here rather than see-through: words over a game that is
    // still moving are the hardest thing on the screen to read, which is the whole point of this skin.
    "chat": {
      "background": { "fill": "#000000", "corner": 6, "border": "#FFFFFF", "padding": [10, 8], "borderWidth": 2 },
      "textColour": "#FFFFFF"
    },
    "chat.message": { "textColour": "#FFFFFF", "text": { "size": 14 } },
    "chat.system": { "textColour": "#FFD600", "text": { "size": 14 } },
    "chat.name": { "textColour": "#00E5FF", "text": { "size": 14 } },
    "chat.channel": { "textColour": "#B0B0B0", "text": { "size": 14 } },

    "chat.tab": {
      "background": { "fill": "#000000", "corner": 4, "border": "#FFFFFF", "padding": [10, 4], "borderWidth": 2 },
      "textColour": "#FFFFFF",
      "text": { "size": 13 },
      "hovered": { "background": { "fill": "#333333", "corner": 4, "border": "#FFFFFF", "borderWidth": 2 } },
      "focused": { "background": { "fill": "#000000", "corner": 4, "border": "#FFD600", "borderWidth": 2 } },
      "pressed": {
        "background": { "fill": "#000000", "corner": 4, "border": "#FFFFFF", "borderWidth": 2 },
        "contentOffset": [0, 1]
      }
    },
    "chat.tab.selected": {
      "background": { "fill": "#0033AA", "corner": 4, "border": "#FFD600", "padding": [10, 4], "borderWidth": 2 },
      "textColour": "#FFFFFF",
      "text": { "size": 13 },
      "hovered": { "background": { "fill": "#0044CC", "corner": 4, "border": "#FFE866", "borderWidth": 2 } },
      "focused": { "background": { "fill": "#0033AA", "corner": 4, "border": "#FFD600", "borderWidth": 2 } },
      "pressed": {
        "background": { "fill": "#002277", "corner": 4, "border": "#FFD600", "borderWidth": 2 },
        "contentOffset": [0, 1]
      }
    },

    "chat.field": {
      "background": { "fill": "#00000000", "padding": [2, 3] },
      "textColour": "#FFFFFF"
    },
    "chat.field.placeholder": { "textColour": "#B0B0B0" },
    "chat.field.caret": { "background": { "fill": "#FFFFFF" } },
    "chat.field.selection": { "background": { "fill": "#2C6BD6" } },
    "chat.field.composition": { "background": { "fill": "#FFFFFF" } },

    // --- text ---

    "label": {
      "disabled": { "textColour": "#B0B0B0" }
    },
    "label.title": { "text": { "size": 22 } },
    "label.heading": { "text": { "size": 18 } },
    "label.dim": { "textColour": "#FFFFFF" },
    "label.danger": { "textColour": "#FF5050" },
    "label.good": { "textColour": "#00E060" },

    // --- buttons ---
    //
    // Four states, and the pressed one moves its contents a pixel: the cheapest convincing thing
    // in a game interface, and it belongs here rather than in a widget.

    "button": {
      "background": { "fill": "#000000", "corner": 5, "border": "#FFFFFF", "padding": [14, 8], "borderWidth": 2 },
      "hovered": { "background": { "fill": "#333333", "corner": 5, "border": "#FFFFFF", "borderWidth": 2 } },
      "focused": { "background": { "fill": "#000000", "corner": 5, "border": "#FFD600", "borderWidth": 2 } },
      "pressed": {
        "background": { "fill": "#000000", "corner": 5, "border": "#FFFFFF", "borderWidth": 2 },
        "contentOffset": [0, 1]
      },
      "disabled": { "textColour": "#B0B0B0", "tint": "#A0FFFFFF" }
    },

    // A KeyBindButton waiting for a press: yellow text in a yellow frame, so "the next key you
    // press goes here" cannot be missed on a list of twenty of them.
    "button.listening": {
      "background": { "fill": "#000000", "corner": 5, "border": "#FFD600", "padding": [14, 8], "borderWidth": 2 },
      "textColour": "#FFD600"
    },

    "button.primary": {
      "background": { "fill": "#0033AA", "corner": 5, "border": "#FFD600", "padding": [14, 8], "borderWidth": 2 },
      "hovered": { "background": { "fill": "#0044CC", "corner": 5, "border": "#FFE866", "borderWidth": 2 } },
      "pressed": { "background": { "fill": "#002277", "corner": 5, "border": "#FFD600", "borderWidth": 2 } }
    },

    "button.danger": {
      "background": { "fill": "#660000", "corner": 5, "border": "#FF5050", "padding": [14, 8], "borderWidth": 2 },
      "hovered": { "background": { "fill": "#990000", "corner": 5, "border": "#FF8080", "borderWidth": 2 } },
      "pressed": { "background": { "fill": "#440000", "corner": 5, "border": "#FF5050", "borderWidth": 2 } }
    },

    "button.quiet": {
      "background": "none",
      "textColour": "#FFFFFF",
      "padding": [10, 6],
      "hovered": { "textColour": "#FFFFFF", "background": { "fill": "#000000", "corner": 5 } },
      "pressed": { "contentOffset": [0, 1] }
    },

    "button.icon": {
      "background": { "fill": "#000000", "corner": 5, "border": "#FFFFFF", "padding": 6, "borderWidth": 2 },
      "hovered": { "background": { "fill": "#333333", "corner": 5, "border": "#FFFFFF", "borderWidth": 2 } },
      "pressed": { "contentOffset": [0, 1] }
    },

    // --- things that take a value ---

    "checkbox": {
      "background": { "fill": "#000000", "corner": 3, "border": "#FFFFFF", "padding": 3, "borderWidth": 2 },
      "hovered": { "background": { "fill": "#000000", "corner": 3, "border": "#FFD600", "borderWidth": 2 } },
      "focused": { "background": { "fill": "#000000", "corner": 3, "border": "#FFD600", "borderWidth": 2 } }
    },

    "checkbox.tick": { "background": { "fill": "#FFD600", "corner": 2 } },

    "radio": {
      "background": { "fill": "#000000", "corner": 8, "border": "#FFFFFF", "padding": 3, "borderWidth": 2 },
      "hovered": { "background": { "fill": "#000000", "corner": 8, "border": "#FFD600", "borderWidth": 2 } },
      "focused": { "background": { "fill": "#000000", "corner": 8, "border": "#FFD600", "borderWidth": 2 } }
    },

    "radio.dot": { "background": { "fill": "#FFD600", "corner": 5 } },

    // A switch says which way it is by where its knob is, so the track only has to say on or off.
    // The knob is as tall as the track's padding leaves it: fatten the track here and the knob
    // follows without anybody editing a widget.

    "toggle": {
      "background": { "fill": "#000000", "corner": 11, "border": "#FFFFFF", "padding": 3, "borderWidth": 2 },
      "hovered": { "background": { "fill": "#000000", "corner": 11, "border": "#FFD600", "borderWidth": 2 } },
      "focused": { "background": { "fill": "#000000", "corner": 11, "border": "#FFD600", "borderWidth": 2 } },
      "disabled": { "tint": "#A0FFFFFF" }
    },

    "toggle.on": {
      "background": { "fill": "#002277", "corner": 11, "border": "#FFD600", "padding": 3, "borderWidth": 2 },
      "hovered": { "background": { "fill": "#0033AA", "corner": 11, "border": "#FFE866", "borderWidth": 2 } },
      "focused": { "background": { "fill": "#002277", "corner": 11, "border": "#FFE866", "borderWidth": 2 } },
      "disabled": { "tint": "#A0FFFFFF" }
    },

    "toggle.knob": { "background": { "fill": "#FFFFFF", "corner": 8 } },

    "slider.track": { "background": { "fill": "#404040", "corner": 3 } },
    "slider.fill": { "background": { "fill": "#FFD600", "corner": 3 } },
    "slider.knob": {
      "background": { "fill": "#FFFFFF", "corner": 8 },
      "hovered": { "background": { "fill": "#FFFFFF", "corner": 8 } },
      "focused": { "background": { "fill": "#FFFFFF", "corner": 8, "border": "#FFD600", "borderWidth": 2 } }
    },

    // A pan-and-zoom canvas is a window onto a world, so its own look is only the backdrop behind
    // that world and a ring when the pad has focus on the canvas itself.

    "panzoom": {
      "background": { "fill": "#000000" },
      "focused": { "background": { "fill": "#000000", "border": "#FFD600", "borderWidth": 2 } }
    },

    // A scene view keeps the game's picture; focus is the yellow edge over it, thick enough to see
    // against any scene.

    "sceneview": {
      "background": "none",
      "focused": { "background": { "fill": "#00000000", "border": "#FFD600", "borderWidth": 3 } }
    },

    // A splitter's divider is a white bar on the black, yellow while it is held; focus is the yellow
    // edge round it.

    "splitter": {
      "background": { "fill": "#FFFFFF", "corner": 2 },
      "hovered": { "background": { "fill": "#FFFFFF", "corner": 2 } },
      "pressed": { "background": { "fill": "#FFD600", "corner": 2 } },
      "focused": { "background": { "fill": "#FFFFFF", "corner": 2, "border": "#FFD600", "borderWidth": 2 } },
      "disabled": { "background": { "fill": "#B0B0B0", "corner": 2 } }
    },

    // A colour picker on black: white frames round the square and strips, yellow where focus is,
    // and a white ring outlined in black so it shows on any colour.

    "colourpicker": {
      "background": { "fill": "#000000", "corner": 6, "border": "#FFFFFF", "padding": 10, "borderWidth": 2 }
    },
    "colourpicker.area": {
      "background": { "fill": "#000000", "corner": 2, "border": "#FFFFFF", "borderWidth": 2 },
      "hovered": { "background": { "fill": "#000000", "corner": 2, "border": "#FFD600", "borderWidth": 2 } },
      "focused": { "background": { "fill": "#000000", "corner": 2, "border": "#FFD600", "borderWidth": 2 } },
      "disabled": { "background": { "fill": "#000000", "corner": 2, "border": "#B0B0B0", "borderWidth": 2 }, "tint": "#B0FFFFFF" }
    },
    "colourpicker.marker": { "background": { "fill": "#000000" }, "textColour": "#FFFFFF" },
    "colourpicker.checker": { "background": { "fill": "#FFFFFF" }, "textColour": "#808080" },
    "colourswatch": {
      "background": { "fill": "#000000", "corner": 3, "border": "#FFFFFF", "padding": 2, "borderWidth": 2 },
      "hovered": { "background": { "fill": "#000000", "corner": 3, "border": "#FFD600", "padding": 2, "borderWidth": 2 } },
      "focused": { "background": { "fill": "#000000", "corner": 3, "border": "#FFD600", "borderWidth": 2, "padding": 2 } },
      "pressed": { "background": { "fill": "#000000", "corner": 3, "border": "#FFD600", "borderWidth": 2, "padding": 2 } },
      "disabled": { "background": { "fill": "#000000", "corner": 3, "border": "#B0B0B0", "padding": 2, "borderWidth": 2 }, "tint": "#B0FFFFFF" }
    },

    // A stepper is picked with left and right, so its arrows are what say it is one. An arrow at an
    // end it cannot pass is dimmed rather than hidden, so the value does not jump sideways.

    "stepper": {
      "background": { "fill": "#000000", "corner": 5, "border": "#FFFFFF", "padding": [2, 4], "borderWidth": 2 },
      "hovered": { "background": { "fill": "#000000", "corner": 5, "border": "#FFD600", "borderWidth": 2 } },
      "focused": { "background": { "fill": "#000000", "corner": 5, "border": "#FFD600", "borderWidth": 2 } },
      "disabled": { "tint": "#A0FFFFFF" }
    },

    "stepper.arrow": {
      "textColour": "#FFFFFF",
      "padding": [10, 2],
      "hovered": { "textColour": "#FFFFFF" },
      "focused": { "textColour": "#FFD600" },
      "pressed": { "textColour": "#FFFFFF", "contentOffset": [0, 1] },
      "disabled": { "textColour": "#808080" }
    },

    "stepper.value": { "textColour": "#FFFFFF", "padding": [8, 2] },

    // A game's bar, which is a progress bar with a memory: the trail is the ghost of what was
    // there a moment ago, drawn behind the fill, and the segment is the notch between two blocks.

    "bar.track": { "background": { "fill": "#000000", "corner": 3, "border": "#FFFFFF", "borderWidth": 2 } },
    "bar.fill": { "background": { "fill": "#00E060", "corner": 3 } },
    "bar.fill.low": { "background": { "fill": "#FFB000", "corner": 3 } },
    "bar.fill.critical": { "background": { "fill": "#FF5050", "corner": 3 } },
    "bar.trail": { "background": { "fill": "#660000", "corner": 3 } },
    "bar.segment": { "background": { "fill": "#000000" } },

    // A number flying off something that was hit. A critical is bigger as well as brighter: a
    // player reads the size before the colour.

    "damage": { "textColour": "#FFFF80", "text": { "size": 18 } },
    "damage.critical": { "textColour": "#FF8000", "text": { "size": 26 } },

    // The arc that says which way a hit came from, and the ring that closes in when the player is
    // nearly dead. Both are more solid here than in the default skin, because the whole point of
    // this skin is that nothing is left to a player's ability to pick a faint shape out of a scene.

    "damage.direction": { "background": { "fill": "#FFFF5050" } },
    "vignette": { "background": { "fill": "#FFC00000" } },

    // The triangle beside a world marker held at the edge of the screen. White, because it has to
    // be read against whatever the game happens to be drawing behind it.

    "marker.arrow": { "background": { "fill": "#FFFFFF" } },

    // --- the hotbar ---
    //
    // An empty slot is a hole in the bar: no fill, a dashed-looking groove, nothing in it. A slot
    // with something in it that cannot be used right now is a full slot, dimmed. A player has to
    // be able to tell those two apart at a glance, so they are two different styles rather than
    // one style at two opacities.

    "hotbar.slot": {
      "background": { "fill": "#000000", "corner": 6, "border": "#FFFFFF", "borderWidth": 2 },
      "hovered": { "background": { "fill": "#333333", "corner": 6, "border": "#FFFFFF", "borderWidth": 2 } },
      "focused": { "background": { "fill": "#000000", "corner": 6, "border": "#FFD600", "borderWidth": 2 } },
      "disabled": { "textColour": "#B0B0B0", "tint": "#90FFFFFF" }
    },

    "hotbar.slot.selected": {
      "background": { "fill": "#000000", "corner": 6, "border": "#FFD600", "borderWidth": 2 },
      "hovered": { "background": { "fill": "#333333", "corner": 6, "border": "#FFE866", "borderWidth": 2 } }
    },

    "hotbar.slot.empty": {
      "background": { "fill": "#000000", "corner": 6, "border": "#FFFFFF", "borderWidth": 2 }
    },

    "hotbar.prompt": { "textColour": "#FFFFFF", "text": { "size": 12 } },
    "hotbar.charges": { "textColour": "#FFFFFF", "text": { "size": 12 } },

    // --- the inventory grid ---
    //
    // An empty square is a hole to put something in, and a square with something in it is a tile
    // over that hole. Here the difference is the edge rather than the fill, since everything is
    // black: a free square is outlined in grey and a full one in white. The two footprints keep
    // the green and the red of the standard skin, at full strength — "it goes here" and "it does
    // not" are the one pair a colour-blind player is told by the shape underneath as well.

    "inventory.cell": {
      "background": { "fill": "#000000", "corner": 4, "border": "#808080", "borderWidth": 2 },
      "hovered": { "background": { "fill": "#000000", "corner": 4, "border": "#FFFFFF", "borderWidth": 2 } },
      "focused": { "background": { "fill": "#000000", "corner": 4, "border": "#FFD600", "borderWidth": 2 } }
    },

    "inventory.item": {
