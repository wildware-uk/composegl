    //
    // On a console this ring is not decoration, it is the only thing telling a player where they
    // are, so it is bright and it is its own style for a game to make brighter.

    "focusRing": {
      "background": { "fill": "#00000000", "corner": 6, "border": "#FFD600", "borderWidth": 3 }
    },

    // --- live plots ---
    //
    // The same graphs in black and white: a white trace on black, a grey rule and a yellow cursor.
    // The same padding and the same text sizes as the default, so switching skins does not move a
    // graph or the numbers written in its corners.

    "plot": {
      "background": { "fill": "#000000", "border": "#FFFFFF", "padding": [6, 4], "borderWidth": 2 },
      "textColour": "#FFFFFF"
    },

    "plot.label": { "textColour": "#B0B0B0", "text": { "size": 11 } },
    "plot.value": { "textColour": "#FFFFFF", "text": { "size": 11 } },

    "plot.line": { "textColour": "#FFFFFF" },
    "plot.fill": { "textColour": "#40FFFFFF" },
    "plot.guide": { "textColour": "#B0B0B0" },
    "plot.cursor": { "textColour": "#FFD600" },
    "plot.bar": { "textColour": "#FFFFFF" },

    // --- the developer console ---
    //
    // The same panel in black and white: white for an ordinary line, yellow for a warning, red for
    // a failure, cyan for the line that was typed. Every one of them is above the 4.5:1 the
    // accessibility guidelines ask for, measured in the skin's own test.

    "console": {
      "background": { "fill": "#000000", "border": "#FFFFFF", "padding": 10, "borderWidth": 2 },
      "textColour": "#FFFFFF"
    },

    "console.title": { "textColour": "#B0B0B0", "text": { "size": 13 } },
    "console.prompt": { "textColour": "#FFD600" },

    "console.line": { "textColour": "#FFFFFF", "text": { "size": 14 } },
    "console.line.debug": { "textColour": "#B0B0B0", "text": { "size": 14 } },
    "console.line.info": { "textColour": "#FFFFFF", "text": { "size": 14 } },
    "console.line.warn": { "textColour": "#FFD600", "text": { "size": 14 } },
    "console.line.error": { "textColour": "#FF5050", "text": { "size": 14 } },
    "console.line.echo": { "textColour": "#00E5FF", "text": { "size": 14 } },

    "console.suggestion": { "textColour": "#B0B0B0", "padding": [6, 2], "text": { "size": 14 } },
    "console.suggestion.selected": {
      "background": { "fill": "#2C6BD6", "corner": 3 },
      "textColour": "#FFFFFF",
      "padding": [6, 2],
      "text": { "size": 14 }
    },

    "console.field": {
      "background": { "fill": "#00000000", "padding": [2, 3] },
      "textColour": "#FFFFFF"
    },
    "console.field.placeholder": { "textColour": "#B0B0B0" },
    "console.field.caret": { "background": { "fill": "#FFFFFF" } },
    "console.field.selection": { "background": { "fill": "#2C6BD6" } },
    "console.field.composition": { "background": { "fill": "#FFFFFF" } }
  }
}
